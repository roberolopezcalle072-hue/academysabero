---
import BaseLayout from '../shared/presentation/BaseLayout.astro';
import { PROMO, money, discountPercent } from '../features/landing/promo';

const state = Astro.url.searchParams.get('estado');
const messages = new Map([
  ['acceso', 'No se pudo habilitar el acceso con esta cuenta. Escríbenos si crees que es un error.'],
  ['servicio', 'El servicio de acceso no está disponible. Inténtalo de nuevo.'],
  ['oauth', 'No se pudo iniciar sesión con Google. Inténtalo de nuevo.'],
  ['credenciales', 'Correo o contraseña incorrectos. Revisa tus datos e inténtalo de nuevo.'],
  ['confirmar', 'Primero confirma tu correo: te enviamos un enlace al registrarte.'],
  ['matricula', 'Ingresa el código de matrícula que recibiste.'],
  ['codigo', 'No se pudo canjear el código. Comprueba que corresponde a esta cuenta y sigue vigente.'],
]);
const message = state ? messages.get(state) : undefined;
const redeem = state === 'matricula' || state === 'codigo' || state === 'activar';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<BaseLayout dark title="Iniciar sesión">
  <div class="dk">
    <section class="shell authx">
      <div class="authx-grid">
        <div class="visual">
          <img src="/images/agente-ia.webp" alt="Alumnos con el agente de IA de ventas de SABERO Academy" width="1400" height="788" fetchpriority="high" />
          <div class="overlay">
            <p class="kicker">SABERO Academy</p>
            <h1>Bienvenido a tu <em>campus</em></h1>
            <p>Entra para ver tus cursos, tus sesiones en vivo y tus materiales.</p>
            <span class="offer">Curso Agente de IA <b>{money(PROMO.priceOffer)}</b> <s>{money(PROMO.priceRegular)}</s> -{discountPercent}%</span>
          </div>
        </div>

        <div class="panel dk-card">
          <h2>{redeem ? 'Activa tu matrícula' : 'Iniciar sesión'}</h2>
          {message && <p class="notice" role="status">{message}</p>}
          {redeem ? (
            <>
              <form action="/auth/canjear" method="post" class="full">
                <label for="code">Código de matrícula</label>
                <input id="code" name="code" minlength="32" maxlength="128" autocomplete="off" autocapitalize="off" spellcheck="false" required />
                <button class="dk-btn wide">Activar matrícula</button>
              </form>
              <form action="/auth/salir" method="post" class="full"><button class="dk-btn ghost wide">Cerrar sesión</button></form>
            </>
          ) : (
            <>
              <form action="/auth/entrar" method="post" class="full">
                <label for="email">Correo electrónico</label>
                <input id="email" name="email" type="email" maxlength="254" autocomplete="email" required />
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password" maxlength="200" autocomplete="current-password" required />
                <button class="dk-btn wide">Iniciar sesión</button>
              </form>
              <p class="or"><span>o</span></p>
              <form action="/auth/google" method="post" class="full"><button class="dk-btn ghost wide gbtn"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.5-.2-2.2H12v4.200h5.900c-.3 1.400-1 2.500-2.200 3.300v2.700h3.500c2.100-1.900 3.300-4.700 3.300-8z"/><path fill="#34A853" d="M12 23c3 0 5.500-1 7.300-2.700l-3.500-2.700c-1 .7-2.200 1.100-3.800 1.100-2.900 0-5.400-2-6.300-4.600H2.100v2.800C3.900 20.500 7.700 23 12 23z"/><path fill="#FBBC05" d="M5.700 14.100c-.2-.7-.4-1.400-.4-2.100s.1-1.400.4-2.100V7.100H2.100C1.400 8.600 1 10.200 1 12s.4 3.400 1.100 4.900l3.600-2.800z"/><path fill="#EA4335" d="M12 5.400c1.600 0 3.100.6 4.200 1.700l3.100-3.100C17.500 2.200 15 1 12 1 7.700 1 3.900 3.500 2.100 7.100l3.600 2.800C6.600 7.400 9.100 5.400 12 5.400z"/></svg> Continuar con Google</button></form>
              <p class="switch">¿Aún no tienes cuenta? <a href="/registro">Crear cuenta</a></p>
            </>
          )}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>

  .authx { padding-block: clamp(1.5rem, 3.5vw, 3rem); }
  .authx-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(1.25rem, 3vw, 2.5rem); align-items: stretch; }
  .visual { position: relative; min-height: 34rem; border-radius: 28px; overflow: hidden; border: 1.5px solid #2a63d6; box-shadow: 0 0 44px rgb(31 123 255 / .28); isolation: isolate; }
  .visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% center; z-index: -2; }
  .visual::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(4 12 42 / .25) 0%, rgb(4 12 42 / .55) 45%, rgb(4 12 42 / .94) 100%), linear-gradient(90deg, rgb(4 12 42 / .55), transparent 60%); }
  .visual .overlay { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(1.5rem, 3vw, 2.5rem); display: grid; gap: .9rem; justify-items: start; }
  .visual h1 { font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -.03em; line-height: 1.05; }
  .visual h1 em { font-style: normal; background: linear-gradient(95deg, #1ee3ff, #2f8dff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .visual p { color: #e1ebff; max-width: 34ch; }
  .perks { margin: 0; padding: 0; list-style: none; display: grid; gap: .55rem; }
  .perks li { position: relative; padding-left: 1.7rem; color: #e1ebff; }
  .perks li::before { content: "✓"; position: absolute; left: 0; top: .05rem; width: 1.2rem; height: 1.2rem; display: grid; place-items: center; font-size: .75rem; font-weight: 800; border-radius: 50%; background: #1fa971; color: #fff; }
  .offer { display: inline-flex; align-items: center; gap: .7rem; padding: .55rem 1rem; border: 1px solid rgb(255 178 28 / .55); background: rgb(255 178 28 / .1); border-radius: 999px; color: #ffe08a; font-weight: 700; font-size: .9rem; }
  .offer b { font-size: 1.3rem; color: #ffd54a; letter-spacing: -.02em; }
  .offer s { color: #9fb2d6; font-weight: 500; }
  .panel { align-self: center; padding: clamp(1.4rem, 3vw, 2.25rem); display: grid; gap: .75rem; }
  .panel h2 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); letter-spacing: -.02em; }
  .panel .lead { color: #c7d6f2; font-size: .95rem; margin-top: -.35rem; }
  .full { width: 100%; display: grid; gap: .55rem; }
  label { font-weight: 600; font-size: .88rem; }
  label small { font-weight: 400; color: #8aa0c6; }
  .check { display: flex; gap: .6rem; align-items: flex-start; font-weight: 400; color: #c7d6f2; margin-top: .2rem; }
  .check input { margin-top: .25rem; min-height: 0; }
  .wide { width: 100%; margin-top: .35rem; }
  .or { width: 100%; display: flex; align-items: center; gap: .75rem; color: #8aa0c6; font-size: .85rem; margin: .1rem 0; }
  .or::before, .or::after { content: ""; flex: 1; height: 1px; background: #243f7e; }
  .switch { color: #c7d6f2; font-size: .92rem; text-align: center; }
  .gbtn svg { flex: none; }
  @media (max-width: 56rem) {
    .authx-grid { grid-template-columns: minmax(0, 1fr); }
    .visual { min-height: 0; display: grid; border-radius: 22px; background: linear-gradient(180deg, #061547, #050f33); }
    .visual img { position: relative; z-index: auto; height: 11rem; -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent); mask-image: linear-gradient(to bottom, #000 62%, transparent); }
    .visual::after { display: none; }
    .visual .overlay { position: static; padding: .25rem 1.25rem 1.25rem; gap: .7rem; margin-top: -2.25rem; position: relative; }
    .visual h1 { font-size: 1.65rem; }
    .perks { gap: .4rem; font-size: .92rem; }
    .offer { font-size: .82rem; padding: .45rem .85rem; }
  }
</style>
