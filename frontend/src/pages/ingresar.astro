---
import BaseLayout from '../shared/presentation/BaseLayout.astro';

const state = Astro.url.searchParams.get('estado');
const messages = new Map([
  ['acceso', 'No se pudo habilitar el acceso con esta cuenta. Escríbenos si crees que es un error.'],
  ['servicio', 'El servicio de acceso no está disponible. Inténtalo de nuevo.'],
  ['oauth', 'No se pudo iniciar sesión con Google. Inténtalo de nuevo.'],
  ['credenciales', 'Correo o contraseña incorrectos. Revisa tus datos e inténtalo de nuevo.'],
  ['confirmar', 'Primero confirma tu correo: te enviamos un enlace al registrarte.'],
  ['matricula', 'Ingresa el código de matrícula que recibiste.'],
  ['codigo', 'No se pudo canjear el código. Comprueba que corresponde a esta cuenta y sigue vigente.'],
]);
const message = state ? messages.get(state) : undefined;
const redeem = state === 'matricula' || state === 'codigo' || state === 'activar';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<BaseLayout title="Iniciar sesión">
  <section class="login">
    <div class="shell login-grid">
      <div class="stack brand-block">
        <p class="kicker">SABERO Academy</p>
        <h1 class="panel-title">Accede a tu campus</h1>
        <p>Inicia sesión o crea tu cuenta para ver los cursos disponibles.</p>
        <figure class="frame"><img src="/images/agente-ia.webp" alt="Alumnos con el agente de IA de ventas de SABERO Academy" width="1400" height="788" loading="eager" /></figure>
      </div>
      <div class="stack login-form">
        <h2>{redeem ? 'Activa tu matrícula' : 'Iniciar sesión'}</h2>
        {message && <p class="notice" role="status">{message}</p>}
        {redeem ? (
          <>
            <form action="/auth/canjear" method="post" class="stack compact full">
              <label for="code">Código de matrícula</label>
              <input id="code" name="code" minlength="32" maxlength="128" autocomplete="off" autocapitalize="off" spellcheck="false" required />
              <button class="button primary">Activar matrícula</button>
            </form>
            <form action="/auth/salir" method="post"><button class="button secondary">Cerrar sesión</button></form>
          </>
        ) : (
          <>
            <form action="/auth/entrar" method="post" class="full">
              <label for="email">Correo electrónico</label>
              <input id="email" name="email" type="email" maxlength="254" autocomplete="email" required />
              <label for="password">Contraseña</label>
              <input id="password" name="password" type="password" maxlength="200" autocomplete="current-password" required />
              <button class="button primary wide">Iniciar sesión</button>
            </form>
            <p class="or"><span>o</span></p>
            <form action="/auth/google" method="post" class="full"><button class="button outline wide">Continuar con Google</button></form>
            <p class="switch">¿Aún no tienes cuenta? <a href="/registro">Crear cuenta</a></p>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .login { display: grid; align-items: center; background: linear-gradient(120deg, #f7fafb 40%, #e3f4fb 100%); }
  .login-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; padding-block: clamp(1.5rem, 4vw, 3rem); }
  .brand-block h1 { color: var(--navy); }
  .brand-block .kicker { color: var(--red); }
  .login-form { background: var(--white); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 50px rgb(7 27 53 / .10); padding: clamp(1.25rem, 3vw, 2rem); }
  .full { width: 100%; display: grid; gap: .6rem; }
  label { font-weight: 600; font-size: .9rem; color: var(--navy); }
  .wide { width: 100%; }
  .or { width: 100%; display: flex; align-items: center; gap: .75rem; color: var(--muted); font-size: .85rem; }
  .or::before, .or::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .switch { color: var(--muted); font-size: .92rem; }
  .frame { margin: .5rem 0 0; width: 100%; max-width: 26rem; padding: .5rem; border: 1px solid var(--line); background: var(--white); border-radius: 16px; box-shadow: 0 18px 40px rgb(7 27 53 / .12); }
  .frame img { display: block; width: 100%; height: 9rem; object-fit: cover; object-position: 55% center; border-radius: 10px; }
  @media (max-width: 44rem) { .login-grid { grid-template-columns: 1fr; } .frame img { height: 8rem; } }
</style>
