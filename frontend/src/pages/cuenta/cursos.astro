---
import BaseLayout from '../../shared/presentation/BaseLayout.astro';
import PromoTimer from '../../features/enrollment/PromoTimer.astro';
import { loadCatalog, loadPaymentsConfig } from '../../features/enrollment/infrastructure/enrollment-api';
import { money, moneyIn } from '../../features/landing/promo';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);
const [catalog, payments] = await Promise.all([loadCatalog(token), loadPaymentsConfig()]);
if (!catalog) Astro.response.status = 503;
const discount = (regular: number, offer: number) => Math.round((1 - offer / regular) * 100);
---
<BaseLayout title="Cursos disponibles" privatePage dark>
  <div class="dk">
  <section class="shell page stack">
    <div class="stack compact">
      <p class="kicker">Cursos</p>
      <h1 class="panel-title">Cursos disponibles</h1>
      <p class="sub">Elige tu curso e inscríbete. Validamos tu solicitud y te damos acceso al campus.</p>
    </div>

    {catalog === null && <p class="notice" role="status">No se pudo cargar el catálogo. Inténtalo de nuevo en unos minutos.</p>}
    {catalog && catalog.length === 0 && <p class="notice" role="status">Pronto publicaremos nuevos cursos.</p>}

    <div class="courses">
      {catalog?.map((c) => (
        <article class="course dk-card">
          <img src={c.image_path} alt={`Portada del curso ${c.name}`} width="1500" height="844" />
          <div class="body">
            <span class="tag">-{discount(c.price_regular, c.price_offer)}% oferta de lanzamiento</span>
            <h2>{c.name}</h2>
            <p class="desc">{c.description}</p>
            <PromoTimer />
            <p class="price"><s>{moneyIn(c.price_regular, c.currency)}</s><strong>{moneyIn(c.price_offer, c.currency)}</strong><span>{c.currency}</span></p>
            {c.price_offer_pen !== null && c.price_regular_pen !== null && <p class="pen">Desde Perú: <b>{moneyIn(c.price_offer_pen, 'PEN')}</b> <s>{moneyIn(c.price_regular_pen, 'PEN')}</s></p>}
            {c.enrolled ? (
              <a class="dk-btn" href="/campus">Ir al curso</a>
            ) : c.request_status === 'pending' && !payments.enabled ? (
              <span class="dk-btn ghost" aria-disabled="true">Solicitud en revisión</span>
            ) : (
              <a class="dk-btn amber" href={`/cuenta/inscripcion/${c.id}`}>Inscribirme ahora ›</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  .sub { color: #c7d6f2; }
  section { padding-block: clamp(2rem, 4vw, 3.5rem); }
  .courses { width: 100%; display: grid; gap: 1.5rem; }
  .course { overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); padding: 0; }
  .course img { width: 100%; height: 100%; min-height: 18rem; object-fit: cover; display: block; border-right: 1px solid #1f3f86; }
  @media (max-width: 56rem) { .course { grid-template-columns: minmax(0, 1fr); } .course img { min-height: 0; aspect-ratio: 16 / 9; border-right: 0; border-bottom: 1px solid #1f3f86; } }
  .body { padding: 1.35rem 1.5rem 1.6rem; display: grid; gap: .9rem; justify-items: start; }
  .tag { background: rgb(255 178 28 / .14); color: #ffd566; border: 1px solid rgb(255 178 28 / .5); font-weight: 700; font-size: .75rem; padding: .25rem .7rem; border-radius: 999px; }
  .course h2 { font-size: 1.5rem; letter-spacing: -.02em; }
  .desc { color: #c7d6f2; font-size: .95rem; }
  .price { display: flex; align-items: baseline; gap: .7rem; }
  .price s { color: #8aa0c6; font-size: 1.15rem; text-decoration-color: #e4313f; }
  .price strong { font-size: 2.8rem; font-weight: 800; letter-spacing: -.04em; line-height: 1; background: linear-gradient(180deg, #ffe27a, #ffb21c); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .price span { color: #ffd566; font-size: .85rem; font-weight: 800; }
  .pen { color: #bcd0f5; font-size: .9rem; margin-top: -.4rem; }
  .pen b { color: #ffd54a; }
  .pen s { color: #7f93b3; margin-left: .3rem; }
</style>
