---
import BaseLayout from '../../shared/presentation/BaseLayout.astro';
import PromoTimer from '../../features/enrollment/PromoTimer.astro';
import { loadCatalog } from '../../features/enrollment/infrastructure/enrollment-api';
import { money } from '../../features/landing/promo';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);
const catalog = await loadCatalog(token);
if (!catalog) Astro.response.status = 503;
const discount = (regular: number, offer: number) => Math.round((1 - offer / regular) * 100);
---
<BaseLayout title="Cursos disponibles" privatePage>
  <section class="shell page stack">
    <div class="stack compact">
      <p class="kicker">Cursos</p>
      <h1 class="panel-title">Cursos disponibles</h1>
      <p class="sub">Elige tu curso e inscríbete. Validamos tu solicitud y te damos acceso al campus.</p>
    </div>

    {catalog === null && <p class="notice" role="status">No se pudo cargar el catálogo. Inténtalo de nuevo en unos minutos.</p>}
    {catalog && catalog.length === 0 && <p class="notice" role="status">Pronto publicaremos nuevos cursos.</p>}

    <div class="courses">
      {catalog?.map((c) => (
        <article class="course">
          <img src={c.image_path} alt="" width="640" height="360" loading="lazy" />
          <div class="body">
            <span class="tag">-{discount(c.price_regular, c.price_offer)}% oferta de lanzamiento</span>
            <h2>{c.name}</h2>
            <p class="desc">{c.description}</p>
            <PromoTimer />
            <p class="price"><s>{money(c.price_regular, c.currency)}</s><strong>{money(c.price_offer, c.currency)}</strong><span>{c.currency}</span></p>
            {c.enrolled ? (
              <a class="button primary" href="/campus">Ir al curso</a>
            ) : c.request_status === 'pending' ? (
              <span class="button outline disabled" aria-disabled="true">Solicitud en revisión</span>
            ) : (
              <a class="button amber" href={`/cuenta/inscripcion/${c.id}`}>Inscribirme</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .sub { color: var(--muted); }
  .courses { width: 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr)); gap: 1.25rem; }
  .course { background: var(--white); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; box-shadow: 0 14px 34px rgb(7 27 53 / .07); display: grid; }
  .course img { width: 100%; height: 12rem; object-fit: cover; object-position: 60% center; display: block; }
  .body { padding: 1.25rem 1.4rem 1.5rem; display: grid; gap: .85rem; justify-items: start; }
  .tag { background: #fff4de; color: #9a5b00; border: 1px solid #f6d28b; font-weight: 700; font-size: .75rem; padding: .25rem .7rem; border-radius: 999px; }
  .desc { color: var(--muted); font-size: .95rem; }
  .price { display: flex; align-items: baseline; gap: .6rem; }
  .price s { color: #8a9bb0; font-size: 1.05rem; }
  .price strong { color: var(--navy); font-size: 2.2rem; font-weight: 800; letter-spacing: -.02em; }
  .price span { color: var(--muted); font-size: .85rem; }
  .button.amber { background: #fbb034; color: #0b1a3a; box-shadow: 0 10px 24px rgb(251 176 52 / .35); }
  .button.amber:hover { background: #ffc35c; box-shadow: none; }
  .disabled { opacity: .7; cursor: default; }
</style>
