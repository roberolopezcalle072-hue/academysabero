---
import BaseLayout from '../../shared/presentation/BaseLayout.astro';
import { createSessionClient } from '../../features/access/infrastructure/supabase-session';
import { whatsappUrl } from '../../features/landing/content';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);

const { data: { user } } = await createSessionClient(Astro).auth.getUser().catch(() => ({ data: { user: null } }));
const email = user?.email ?? '';
const name = String(user?.user_metadata?.full_name ?? user?.user_metadata?.name ?? '').trim();
const hasPassword = user?.identities?.some((identity) => identity.provider === 'email') ?? false;
const viaGoogle = user?.identities?.some((identity) => identity.provider === 'google') ?? false;

const state = Astro.url.searchParams.get('estado');
const ok = state === 'ok';
const messages = new Map([
  ['clave', 'La nueva contraseña debe tener entre 8 y 72 caracteres.'],
  ['distintas', 'Las dos contraseñas nuevas no coinciden.'],
  ['actual', 'La contraseña actual no es correcta.'],
  ['igual', 'Elige una contraseña distinta a la actual.'],
  ['servicio', 'No se pudo guardar la contraseña. Inténtalo de nuevo.'],
]);
const message = state ? messages.get(state) : undefined;
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<BaseLayout title="Mi perfil" privatePage dark>
  <div class="dk">
    <section class="shell page profile">
      <div class="stack compact head">
        <p class="kicker">Mi cuenta</p>
        <h1 class="panel-title">Mi perfil</h1>
      </div>

      <div class="grid">
        <div class="dk-card box">
          <h2>Mis datos</h2>
          <dl>
            {name && <div><dt>Nombre</dt><dd>{name}</dd></div>}
            <div><dt>Correo</dt><dd>{email}</dd></div>
            <div><dt>Acceso</dt><dd>{[hasPassword && 'Correo y contraseña', viaGoogle && 'Google'].filter(Boolean).join(' · ') || '—'}</dd></div>
          </dl>
        </div>

        <div class="dk-card box">
          <h2>{hasPassword ? 'Cambiar contraseña' : 'Crear una contraseña'}</h2>
          {!hasPassword && <p class="hint">Entras con Google. Si quieres, crea también una contraseña para entrar con tu correo.</p>}
          {ok && <p class="notice okmsg" role="status">Tu contraseña se actualizó correctamente.</p>}
          {message && <p class="notice" role="status">{message}</p>}
          <form action="/auth/cambiar-clave" method="post" class="full">
            {hasPassword && (
              <>
                <label for="current">Contraseña actual</label>
                <input id="current" name="current" type="password" maxlength="200" autocomplete="current-password" required />
              </>
            )}
            <label for="password">Nueva contraseña <small>(mínimo 8 caracteres)</small></label>
            <input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required />
            <label for="confirm">Repite la nueva contraseña</label>
            <input id="confirm" name="confirm" type="password" minlength="8" maxlength="72" autocomplete="new-password" required />
            <button class="dk-btn wide">Guardar contraseña</button>
          </form>
          <p class="hint">¿No recuerdas tu contraseña actual? {whatsappUrl ? <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a> : 'Escríbenos'} y te la restablecemos.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .profile { display: grid; gap: 1.25rem; padding-block: clamp(2rem, 4vw, 3.5rem); }
  .grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 1.25rem; align-items: start; }
  .box { padding: clamp(1.25rem, 3vw, 2rem); display: grid; gap: .8rem; }
  .box h2 { font-size: 1.3rem; letter-spacing: -.02em; }
  dl { margin: 0; display: grid; gap: .9rem; }
  dt { color: #8aa0c6; font-size: .8rem; }
  dd { margin: .1rem 0 0; color: #fff; font-weight: 600; }
  .full { display: grid; gap: .55rem; }
  label { font-weight: 600; font-size: .88rem; }
  label small { font-weight: 400; color: #8aa0c6; }
  .wide { width: 100%; margin-top: .4rem; }
  .hint { color: #aebfdc; font-size: .88rem; }
  .okmsg { background: rgb(47 211 122 / .12); border-color: #1f9a5b; }
  @media (max-width: 52rem) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
