---
import BaseLayout from '../../../shared/presentation/BaseLayout.astro';
import PromoTimer from '../../../features/enrollment/PromoTimer.astro';
import { loadCatalog } from '../../../features/enrollment/infrastructure/enrollment-api';
import { money } from '../../../features/landing/promo';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);
const { courseId } = Astro.params;
const catalog = await loadCatalog(token);
if (!catalog) return new Response(null, { status: 503 });
const course = catalog.find((c) => c.id === courseId);
if (!course) return Astro.redirect('/cuenta/cursos', 303);
if (course.enrolled) return Astro.redirect('/campus', 303);
if (course.request_status === 'pending') return Astro.redirect('/cuenta?estado=solicitud-existente', 303);

const state = Astro.url.searchParams.get('estado');
const message = state === 'datos' ? 'Revisa los datos del formulario.' : state === 'terminos' ? 'Debes aceptar los términos para continuar.' : state === 'servicio' ? 'No se pudo enviar tu solicitud. Inténtalo de nuevo.' : '';
const discount = Math.round((1 - course.price_offer / course.price_regular) * 100);
---
<BaseLayout title={`Inscripción · ${course.name}`} privatePage dark>
  <div class="dk">
  <section class="shell page enroll">
    <div class="summary">
      <p class="kicker">Inscripción</p>
      <h1>{course.name}</h1>
      <img src={course.image_path} alt="" width="1500" height="844" />
      <span class="tag">-{discount}% oferta de lanzamiento</span>
      <p class="price"><s>{money(course.price_regular, course.currency)}</s><strong>{money(course.price_offer, course.currency)}</strong><span>{course.currency}</span></p>
      <PromoTimer label="Esta oferta termina en" />
      <div class="need dk-card">
        <h2>Para obtener algo funcional necesitarás</h2>
        <ul>
          <li>Un servidor <strong>VPS</strong></li>
          <li>Un <strong>dominio</strong> propio</li>
          <li>Un <strong>plan de suscripción</strong> de las herramientas</li>
          <li>Los <strong>códigos</strong> o licencias necesarios</li>
          <li><strong>DeepSeek</strong> para las respuestas del agente</li>
        </ul>
        <p>Te asesoramos nosotros en cada paso. Estos costos son aparte del precio del curso.</p>
      </div>
    </div>

    <form class="form dk-card" action="/cuenta/solicitar" method="post">
      <h2>Tus datos</h2>
      {message && <p class="notice" role="status">{message}</p>}
      <input type="hidden" name="courseId" value={course.id} />
      <label for="fullName">Nombre completo</label>
      <input id="fullName" name="fullName" maxlength="120" autocomplete="name" required />
      <label for="phone">WhatsApp o teléfono</label>
      <input id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel" placeholder="+51 999 999 999" required />
      <label for="country">País</label>
      <input id="country" name="country" maxlength="60" autocomplete="country-name" required />
      <label for="notes">¿Algo que quieras contarnos? <small>(opcional)</small></label>
      <textarea id="notes" name="notes" rows="3" maxlength="1000"></textarea>

      <label class="check"><input type="checkbox" name="acceptTerms" required />
        <span>He leído y acepto los <a href="/terminos-compra" target="_blank" rel="noopener">términos y condiciones de compra</a> y la <a href="/reembolso" target="_blank" rel="noopener">política de reembolso</a>, incluido que debo adquirir por mi cuenta VPS, dominio, plan de suscripción, códigos y DeepSeek.</span>
      </label>
      <button class="dk-btn amber wide">Inscribirme por {money(course.price_offer, course.currency)}</button>
      <p class="fine">Validaremos tu solicitud y te contactaremos para coordinar el pago y activar tu acceso.</p>
    </form>
  </section>
  </div>
</BaseLayout>

<style>
  .enroll { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; padding-block: clamp(2rem, 4vw, 3.5rem); }
  .summary { display: grid; gap: 1rem; justify-items: start; }
  .summary h1 { font-size: clamp(1.7rem, 3vw, 2.5rem); letter-spacing: -.03em; }
  .summary img { width: 100%; height: auto; max-width: 34rem; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 18px; border: 1.5px solid #2a63d6; box-shadow: 0 0 36px rgb(31 123 255 / .3); }
  .tag { background: rgb(255 178 28 / .14); color: #ffd566; border: 1px solid rgb(255 178 28 / .5); font-weight: 700; font-size: .75rem; padding: .25rem .7rem; border-radius: 999px; }
  .price { display: flex; align-items: baseline; gap: .7rem; }
  .price s { color: #8aa0c6; font-size: 1.2rem; text-decoration-color: #e4313f; }
  .price strong { font-size: 3rem; font-weight: 800; letter-spacing: -.04em; line-height: 1; background: linear-gradient(180deg, #ffe27a, #ffb21c); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .price span { color: #ffd566; font-size: .85rem; font-weight: 800; }
  .need { padding: 1.2rem 1.4rem; display: grid; gap: .55rem; width: 100%; max-width: 34rem; border-radius: 20px; }
  .need h2 { font-size: 1.05rem; }
  .need ul { margin: 0; padding-left: 1.2rem; display: grid; gap: .3rem; color: #dbe7ff; }
  .need strong { color: #fff; }
  .need p { color: #aebfdc; font-size: .88rem; }
  .form { padding: clamp(1.4rem, 3vw, 2.2rem); display: grid; gap: .6rem; }
  label { font-weight: 600; font-size: .9rem; }
  label small { font-weight: 400; color: #8aa0c6; }
  textarea { font: inherit; padding: .6rem .75rem; resize: vertical; }
  .check { display: flex; gap: .6rem; align-items: flex-start; font-weight: 400; color: #c7d6f2; margin-top: .4rem; }
  .check input { margin-top: .25rem; min-height: 0; }
  .wide { width: 100%; margin-top: .5rem; font-size: 1.05rem; }
  .fine { color: #8aa0c6; font-size: .82rem; }
  @media (max-width: 52rem) { .enroll { grid-template-columns: minmax(0, 1fr); } }
</style>
