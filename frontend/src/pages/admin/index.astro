---
import BaseLayout from '../../shared/presentation/BaseLayout.astro';
import AdminNavigation from '../../features/access-admin/presentation/AdminNavigation.astro';
import { loadSummary } from '../../features/access-admin/infrastructure/summary-api';
import { moneyIn } from '../../features/landing/promo';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const data = await loadSummary(token);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const today = cap(new Intl.DateTimeFormat('es-PE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Lima' }).format(new Date()));
const fmt = (iso: string) => new Intl.DateTimeFormat('es-PE', { dateStyle: 'medium', timeZone: 'America/Lima' }).format(new Date(iso));
const revenue = data?.revenue.length ? data.revenue.map((r) => moneyIn(r.total, r.currency)).join(' + ') : '—';
const todo = data ? [
  { n: data.open_inquiries, label: 'Consultas por responder', href: '/admin/consultas' },
  { n: data.open_complaints, label: 'Reclamos abiertos', href: '/admin/reclamos' },
  { n: data.pending_requests, label: 'Solicitudes sin pago', href: '/admin/solicitudes' },
] : [];
const sections = [
  { href: '/admin/cronograma', title: 'Cronograma', text: 'Fecha de inicio, enlaces de Meet y grabaciones de las 20 clases.' },
  { href: '/admin/consultas', title: 'Consultas', text: 'Responde las dudas de los alumnos desde aquí.' },
  { href: '/admin/alumnos', title: 'Alumnos', text: 'Lista de alumnos y restablecer contraseñas.' },
  { href: '/admin/cursos', title: 'Programa y cursos', text: 'Edita el contenido, módulos y lecciones.' },
  { href: '/admin/sesiones', title: 'Sesiones en vivo', text: 'Agenda de reuniones y recuperación de clases.' },
  { href: '/admin/reclamos', title: 'Libro de Reclamaciones', text: 'Reclamos y quejas pendientes de respuesta.' },
];
---
<BaseLayout title="Administración" privatePage dark>
  <div class="dk campus">
  <AdminNavigation />
  <div class="shell page home">
    <header class="top">
      <div>
        <p class="eyebrow">Administración</p>
        <h1>Panel de control</h1>
        <p class="lead">Quien paga el curso queda matriculado automáticamente. Aquí ves cómo va todo.</p>
      </div>
      <p class="date">{today}</p>
    </header>

    {data ? (
      <>
        <section class="stats" aria-label="Resumen">
          <article class="stat"><p class="n">{data.students}</p><p class="l">Alumnos matriculados</p></article>
          <article class="stat"><p class="n">{data.paid_count}</p><p class="l">Pagos confirmados</p></article>
          <article class="stat"><p class="n money">{revenue}</p><p class="l">Ingresos cobrados</p></article>
        </section>

        <section class="card todo" aria-label="Pendientes">
          <div class="head"><h2>Pendientes</h2></div>
          <ul>
            {todo.map((t) => (
              <li class={t.n > 0 ? 'has' : ''}>
                <a href={t.href}><span class="num">{t.n}</span><span class="txt">{t.label}</span><span class="go">→</span></a>
              </li>
            ))}
          </ul>
        </section>

        <section class="card" aria-label="Pagos recientes">
          <div class="head row"><h2>Pagos recientes</h2><a class="link" href="/admin/pagos">Ver todos →</a></div>
          {data.payments.length ? (
            <ul class="pays">
              {data.payments.map((p) => (
                <li>
                  <div class="who"><strong>{p.student}</strong><small>{p.email}</small></div>
                  <span class="course">{p.course}</span>
                  <span class="date2">{fmt(p.date)}</span>
                  <span class={`chip ${p.status}`}>{p.status === 'paid' ? 'Pagado' : 'Reembolsado'}</span>
                  <span class="amt">{moneyIn(p.amount, p.currency)}</span>
                  <a class="link" href={`/cuenta/comprobante/${p.id}`}>Constancia</a>
                </li>
              ))}
            </ul>
          ) : <p class="soft">Todavía no hay pagos confirmados.</p>}
        </section>
      </>
    ) : <p class="notice" role="status">No se pudo cargar el resumen. Inténtalo de nuevo en unos minutos.</p>}

    <section aria-label="Secciones">
      <h2 class="sec">Secciones</h2>
      <div class="cards">
        {sections.map((s) => (
          <a class="tile" href={s.href}><b>{s.title}</b><span>{s.text}</span></a>
        ))}
      </div>
      <p class="foot">¿Necesitas dar acceso a alguien <strong>sin pago</strong> (cortesía o beca)? Usa <a href="/admin/accesos">Accesos manuales</a>.</p>
    </section>
  </div>
  </div>
</BaseLayout>
<style>
  .home { display: grid; gap: 1.4rem; align-content: start; }
  .top { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
  .eyebrow { margin: 0 0 .4rem; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #5cc8ff; }
  h1 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.2rem); font-weight: 700; letter-spacing: -.01em; }
  .lead { margin: .5rem 0 0; color: #93a8d0; font-size: .95rem; }
  .date { margin: 0; color: #7f95bf; font-size: .85rem; white-space: nowrap; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .stat, .card { border: 1px solid rgb(255 255 255 / .09); border-radius: 18px; background: linear-gradient(180deg, rgb(255 255 255 / .045), rgb(255 255 255 / .02)); box-shadow: 0 18px 40px -28px rgb(0 0 0 / .8); }
  .stat { padding: 1.3rem 1.5rem; }
  .n { margin: 0; font-size: 2rem; font-weight: 700; color: #fff; line-height: 1.1; }
  .n.money { font-size: 1.5rem; padding-top: .3rem; }
  .l { margin: .35rem 0 0; color: #8fa6d1; font-size: .85rem; }
  .card { padding: 1.4rem 1.5rem; }
  .head { margin-bottom: .9rem; }
  .head.row { display: flex; justify-content: space-between; align-items: baseline; }
  h2 { margin: 0; font-size: 1.05rem; font-weight: 650; }
  .todo ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .todo a { display: flex; align-items: center; gap: .85rem; padding: .9rem 1rem; border-radius: 14px; border: 1px solid rgb(255 255 255 / .08); background: rgb(255 255 255 / .02); text-decoration: none; color: #dbe7ff; transition: border-color .15s, background .15s; }
  .todo a:hover { border-color: rgb(92 200 255 / .4); background: rgb(255 255 255 / .05); }
  .num { display: grid; place-items: center; min-width: 2.2rem; height: 2.2rem; border-radius: 10px; font-weight: 700; background: rgb(255 255 255 / .08); color: #fff; }
  .has .num { background: rgb(255 193 70 / .18); color: #ffd98a; }
  .txt { flex: 1; font-size: .9rem; font-weight: 500; }
  .go { color: #7f95bf; }
  .pays { list-style: none; margin: 0; padding: 0; }
  .pays li { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.2fr) 6.5rem 6.8rem 5rem 5.5rem; gap: .9rem; align-items: center; padding: .85rem 0; border-top: 1px solid rgb(255 255 255 / .07); font-size: .9rem; }
  .pays li:first-child { border-top: 0; padding-top: .2rem; }
  .who strong { display: block; color: #fff; font-weight: 600; }
  .who small { color: #7f95bf; font-size: .78rem; overflow-wrap: anywhere; }
  .course, .date2 { color: #a9bbdb; }
  .amt { font-weight: 700; color: #fff; white-space: nowrap; }
  .chip { font-size: .72rem; font-weight: 700; padding: .2rem .65rem; border-radius: 999px; border: 1px solid rgb(255 255 255 / .16); color: #dbe7ff; }
  .chip.paid { background: rgb(53 208 127 / .14); border-color: rgb(53 208 127 / .45); color: #8ff0bb; }
  .chip.refunded { background: rgb(255 193 70 / .12); border-color: rgb(255 193 70 / .4); color: #ffd98a; }
  .link { color: #8ec5ff; text-decoration: none; font-weight: 600; font-size: .85rem; }
  .soft { margin: 0; color: #8fa6d1; font-size: .9rem; }
  .sec { margin: .4rem 0 .9rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .tile { display: grid; gap: .35rem; padding: 1.15rem 1.25rem; border-radius: 16px; border: 1px solid rgb(255 255 255 / .09); background: rgb(255 255 255 / .03); text-decoration: none; transition: border-color .15s, background .15s, transform .15s; }
  .tile:hover { border-color: rgb(92 200 255 / .45); background: rgb(255 255 255 / .06); transform: translateY(-1px); }
  .tile b { color: #fff; font-weight: 650; }
  .tile span { color: #8fa6d1; font-size: .85rem; line-height: 1.45; }
  .foot { margin: 1.1rem 0 0; color: #8fa6d1; font-size: .88rem; }
  .foot a { color: #8ec5ff; }
  @media (max-width: 62rem) {
    .stats, .cards, .todo ul { grid-template-columns: minmax(0, 1fr); }
    .pays li { grid-template-columns: minmax(0, 1fr) auto; }
    .pays .course, .pays .date2 { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) { .top { flex-direction: column; align-items: start; } .card, .stat { padding: 1.15rem; border-radius: 16px; } }
</style>
