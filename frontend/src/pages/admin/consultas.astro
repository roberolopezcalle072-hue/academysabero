---
import Pager from '../../shared/presentation/Pager.astro';
import AdminLayout from '../../features/access-admin/presentation/AdminLayout.astro';
import { loadInquiries, replyInquiry } from '../../features/access-admin/infrastructure/inquiries-api';
import { siteUrl } from '../../shared/config/server';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const statusParam = Astro.url.searchParams.get('estado') ?? 'open';
const status = ['open', 'answered', 'all'].includes(statusParam) ? statusParam : 'open';
const pageParam = Astro.url.searchParams.get('page') ?? '1';
const page = /^[1-9]\d{0,4}$/.test(pageParam) ? Number(pageParam) : 1;
const UUID = /^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i;
let message = Astro.url.searchParams.get('guardado') === '1' ? 'Respuesta enviada. El alumno la ve en su campus y le llegó por correo.' : '';
let failed = false;

if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== siteUrl().origin) return new Response(null, { status: 403 });
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  const text = String(form.get('body') ?? '').trim();
  if (UUID.test(id) && text.length >= 2 && text.length <= 5000) {
    const result = await replyInquiry(token, id, text).catch(() => null);
    if (result?.ok) return Astro.redirect(`/admin/consultas?estado=${status}&guardado=1`, 303);
    failed = true;
    message = 'No se pudo guardar la respuesta. Inténtalo de nuevo.';
  } else {
    failed = true;
    message = 'Escribe una respuesta (máximo 5000 caracteres).';
  }
}

const data = await loadInquiries(token, status, page);
const fmt = (iso: string) => new Intl.DateTimeFormat('es-PE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Lima' }).format(new Date(iso));
const tabs = [['open', 'Pendientes'], ['answered', 'Respondidas'], ['all', 'Todas']];
---
<AdminLayout title="Consultas de alumnos">
  <section class="shell page stack inq">
    <div class="stack compact">
      <p class="kicker">Administración</p>
      <h1 class="panel-title">Consultas de alumnos</h1>
      <a href="/admin">← Panel de administración</a>
    </div>
    {message && <p class={`notice ${failed ? 'bad' : ''}`} role="status">{message}</p>}
    <nav class="tabs" aria-label="Estado">
      {tabs.map(([key, label]) => <a href={`/admin/consultas?estado=${key}`} aria-current={status === key ? 'page' : undefined}>{label}</a>)}
    </nav>
    {data === null && <p class="notice" role="status">No se pudo cargar la lista.</p>}
    {data && data.items.length === 0 && <p class="notice" role="status">No hay consultas en este estado.</p>}
    <div class="list">
      {data?.items.map((c) => (
        <article class="item">
          <header>
            <div>
              <h2>{c.subject}</h2>
              <p class="meta">{c.student_name} · <a href={`mailto:${c.student_email}`}>{c.student_email}</a> · {fmt(c.created_at)}</p>
            </div>
            <span class={`state ${c.status}`}>{c.status === 'open' ? 'Pendiente' : 'Respondida'}</span>
          </header>
          <p class="msg">{c.body}</p>
          {c.replies.map((r) => (
            <div class="reply"><p class="meta">Tu respuesta · {fmt(r.created_at)}</p><p class="msg">{r.body}</p></div>
          ))}
          <form method="post" action={`/admin/consultas?estado=${status}`} class="answer">
            <input type="hidden" name="id" value={c.id} />
            <label for={`r-${c.id}`}>{c.replies.length ? 'Agregar otra respuesta' : 'Tu respuesta'}</label>
            <textarea id={`r-${c.id}`} name="body" rows="3" minlength="2" maxlength="5000" required></textarea>
            <button class="button primary">Enviar respuesta</button>
          </form>
        </article>
      ))}
    </div>
    {data && <Pager page={page} hasNext={data.hasNext} href={(n) => `/admin/consultas?estado=${status}&page=${n}`} />}
  </section>
</AdminLayout>
<style>
  .inq { max-width: 60rem; }
  .tabs { display: flex; gap: .5rem; flex-wrap: wrap; }
  .tabs a { padding: .45rem 1rem; border: 1px solid var(--line); border-radius: 999px; color: var(--navy); text-decoration: none; font-weight: 600; font-size: .9rem; }
  .tabs a[aria-current='page'] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .list { width: 100%; display: grid; gap: 1rem; }
  .item { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.3rem; display: grid; gap: .8rem; }
  .item header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .item h2 { font-size: 1.1rem; margin: 0; }
  .meta { color: var(--muted); font-size: .85rem; margin: .25rem 0 0; }
  .state { flex: none; font-size: .75rem; font-weight: 700; padding: .25rem .7rem; border-radius: 999px; border: 1px solid var(--line); }
  .state.open { background: #fff4de; color: #9a5b00; border-color: #f6d28b; }
  .state.answered { background: #effaf2; color: #166534; border-color: #bfe6cb; }
  .msg { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.55; }
  .reply { background: var(--light); border-left: 3px solid var(--blue); border-radius: 10px; padding: .7rem .9rem; display: grid; gap: .3rem; }
  .answer { display: grid; gap: .5rem; }
  .answer label { font-weight: 600; font-size: .88rem; }
  textarea { font: inherit; border: 1px solid #b6c6d4; border-radius: 10px; padding: .6rem .75rem; resize: vertical; }
  .answer .button { justify-self: start; }
  .notice.bad { border-color: #e5a4a4; background: #fff0f0; }
  .pager { display: flex; justify-content: space-between; }
</style>
