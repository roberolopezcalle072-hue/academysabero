---
import AdminLayout from '../../features/access-admin/presentation/AdminLayout.astro';
import Pager from '../../shared/presentation/Pager.astro';
import { apiRequest } from '../../shared/infrastructure/api-request';
import { moneyIn } from '../../features/landing/promo';

const token = Astro.locals.accessToken;
if (!token) return Astro.redirect('/ingresar', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const filterParam = Astro.url.searchParams.get('filtro') ?? 'paid';
const filter = ['paid', 'other', 'all'].includes(filterParam) ? filterParam : 'paid';
const pageParam = Astro.url.searchParams.get('page') ?? '1';
const page = /^[1-9]\d{0,4}$/.test(pageParam) ? Number(pageParam) : 1;

interface Row { id: string; status: string; amount: number; currency: string; course: string; student: string; email: string; reason: string | null; date: string }
const data: { items: Row[]; hasNext: boolean } | null = await apiRequest(`/admin/payments?filter=${filter}&page=${page}`, token)
  .then(async (r) => (r.ok ? await r.json() : null)).catch(() => null);
const fmt = (iso: string) => new Intl.DateTimeFormat('es-PE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Lima' }).format(new Date(iso));
const label: Record<string, string> = { paid: 'Pagado', refunded: 'Reembolsado', pending: 'Sin terminar', processing: 'En proceso', failed: 'No completado' };
const tabs = [['paid', 'Cobrados'], ['other', 'Intentos sin cobro'], ['all', 'Todos']];
---
<AdminLayout title="Pagos">
  <div class="shell page stack pays">
    <header class="top">
      <p class="eyebrow">Administración</p>
      <h1>Pagos</h1>
      <p class="lead">Cobros del curso. Quien paga queda matriculado automáticamente; los intentos fallidos aparecen aparte.</p>
    </header>
    <nav class="tabs" aria-label="Filtro">
      {tabs.map(([key, text]) => <a href={`/admin/pagos?filtro=${key}`} aria-current={filter === key ? 'page' : undefined}>{text}</a>)}
    </nav>

    {data === null && <p class="notice" role="status">No se pudo cargar la lista de pagos.</p>}
    {data && (
      <section class="card">
        {data.items.length ? (
          <ul>
            {data.items.map((p) => (
              <li>
                <div class="who"><strong>{p.student}</strong><small>{p.email}</small></div>
                <span class="course">{p.course}</span>
                <span class="when">{fmt(p.date)}</span>
                <span class={`chip ${p.status}`} title={p.reason ?? undefined}>{label[p.status] ?? p.status}</span>
                <span class="amt">{moneyIn(p.amount, p.currency)}</span>
                {p.status === 'paid' || p.status === 'refunded'
                  ? <a class="link" href={`/cuenta/comprobante/${p.id}`}>Constancia</a>
                  : <span></span>}
              </li>
            ))}
          </ul>
        ) : <p class="soft">No hay pagos en esta lista.</p>}
        <Pager page={page} hasNext={data.hasNext} href={(n) => `/admin/pagos?filtro=${filter}&page=${n}`} label="Paginación de pagos" />
      </section>
    )}
  </div>
</AdminLayout>
<style>
  .pays { display: grid; gap: 1.4rem; align-content: start; max-width: 70rem; }
  .eyebrow { margin: 0 0 .35rem; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #5cc8ff; }
  h1 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.2rem); font-weight: 700; letter-spacing: -.01em; }
  .lead { margin: .5rem 0 0; color: #93a8d0; font-size: .95rem; max-width: 44rem; }
  .tabs { display: flex; gap: .5rem; flex-wrap: wrap; }
  .card { border: 1px solid rgb(255 255 255 / .09); border-radius: 18px; padding: 1.2rem 1.5rem 1.4rem; background: linear-gradient(180deg, rgb(255 255 255 / .045), rgb(255 255 255 / .02)); box-shadow: 0 18px 40px -28px rgb(0 0 0 / .8); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.2fr) 9.5rem 7.5rem 5rem 5.5rem; gap: .9rem; align-items: center; padding: .85rem 0; border-top: 1px solid rgb(255 255 255 / .07); font-size: .9rem; }
  li:first-child { border-top: 0; }
  .who strong { display: block; color: #fff; font-weight: 600; }
  .who small { color: #7f95bf; font-size: .78rem; overflow-wrap: anywhere; }
  .course, .when { color: #a9bbdb; }
  .amt { font-weight: 700; color: #fff; white-space: nowrap; }
  .chip { font-size: .72rem; font-weight: 700; padding: .2rem .65rem; border-radius: 999px; border: 1px solid rgb(255 255 255 / .16); color: #dbe7ff; text-align: center; }
  .chip.paid { background: rgb(53 208 127 / .14); border-color: rgb(53 208 127 / .45); color: #8ff0bb; }
  .chip.refunded, .chip.pending, .chip.processing { background: rgb(255 193 70 / .12); border-color: rgb(255 193 70 / .4); color: #ffd98a; }
  .chip.failed { background: rgb(255 90 90 / .12); border-color: rgb(255 120 120 / .45); color: #ffb4b4; }
  .link { color: #8ec5ff; text-decoration: none; font-weight: 600; font-size: .85rem; }
  .soft { margin: 0; color: #8fa6d1; font-size: .9rem; }
  @media (max-width: 62rem) {
    li { grid-template-columns: minmax(0, 1fr) auto; }
    li .course, li .when { grid-column: 1 / -1; }
  }
</style>
