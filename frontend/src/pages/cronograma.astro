---
import BaseLayout from '../shared/presentation/BaseLayout.astro';
import Curriculum from '../features/schedule/Curriculum.astro';
import ScheduleCalendar from '../features/schedule/ScheduleCalendar.astro';
import ExternalServices from '../features/enrollment/ExternalServices.astro';
import { loadPublicSchedule, longDate, slotRange } from '../features/schedule/schedule-api';

Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60');
const plan = await loadPublicSchedule();
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const title = plan?.program.title ?? 'Malla del curso';
---
<BaseLayout title="Malla del curso" description={plan?.program.tagline || 'Cronograma, módulos y horarios del curso de SABERO Academy.'} dark>
  <div class="dk">
    <section class="shell page malla">
      <header class="hero">
        <p class="eyebrow">Malla del curso</p>
        <h1>{title}</h1>
        {plan?.program.tagline && <p class="tag">{plan.program.tagline}</p>}
        {plan && (
          <ul class="facts">
            <li><b>40 h</b><span>en vivo</span></li>
            <li><b>20</b><span>clases de 2 horas</span></li>
            <li><b>4</b><span>módulos</span></li>
            <li><b>8</b><span>temas</span></li>
            <li><b>10</b><span>estudiantes por grupo</span></li>
          </ul>
        )}
        <div class="cta">
          <a class="btn primary" href="/cuenta/cursos">Inscribirme</a>
          <a class="btn ghost" href="/terminos-compra">Términos de compra</a>
        </div>
      </header>

      {plan ? (
        <>
          {plan.start_date && plan.end_date && (
            <section class="block" aria-label="Fechas y horarios">
              <div class="head">
                <h2>Fechas y horarios</h2>
                <p><b>{cap(longDate(plan.start_date))}</b> al <b>{longDate(plan.end_date)}</b> · Formación práctica en vivo, con acompañamiento del instructor.</p>
              </div>
              <ScheduleCalendar classes={plan.classes} holidays={plan.holidays} />
              <div class="slots">
                <h3>Horarios (hora de Perú)</h3>
                {plan.slots.length > 0 ? (
                  <ul>
                    {plan.slots.map((s) => (
                      <li class={s.full ? 'full' : ''}><b>{slotRange(s.starts, s.ends)}</b><span>{s.label}</span><em>{s.full ? 'Completo' : `${s.remaining} cupos`}</em></li>
                    ))}
                  </ul>
                ) : <p class="soft">Los horarios se publicarán pronto.</p>}
                <p class="soft">Máximo diez estudiantes por grupo. Cada horario se cierra al completar su cupo.</p>
              </div>
            </section>
          )}

          <section class="block" aria-label="Módulos y clases">
            <div class="head"><h2>Los 4 módulos y las 20 clases</h2><p>Toca cada clase para ver su contenido, actividad y entregable. Los materiales y enlaces de las reuniones son solo para estudiantes inscritos.</p></div>
            <Curriculum weeks={plan.weeks} />
          </section>

          <ExternalServices />
        </>
      ) : <p class="notice" role="status">La malla del curso estará disponible muy pronto.</p>}
    </section>
  </div>
</BaseLayout>
<style>
  .malla { display: grid; gap: 1.8rem; align-content: start; padding-block: clamp(2rem, 4vw, 3.5rem); max-width: 64rem; }
  .eyebrow { margin: 0 0 .5rem; font-size: .74rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #5cc8ff; }
  h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.15; }
  .tag { margin: .8rem 0 0; font-size: 1.1rem; color: #cfe0ff; max-width: 42rem; }
  .facts { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .7rem; }
  .facts li { display: grid; gap: .1rem; text-align: center; padding: .8rem .4rem; border: 1px solid rgb(255 255 255 / .1); border-radius: 14px; background: rgb(255 255 255 / .03); }
  .facts b { font-size: 1.4rem; color: #fff; }
  .facts span { font-size: .76rem; color: #8fa6d1; }
  .cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.4rem; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: .6rem 1.6rem; border-radius: 12px; font-weight: 700; text-decoration: none; }
  .btn.primary { color: #3b2a00; background: linear-gradient(180deg, #ffd54a, #ffb21c); box-shadow: 0 10px 26px rgb(255 178 28 / .35); }
  .btn.ghost { color: #e6eeff; border: 1px solid rgb(255 255 255 / .18); background: rgb(255 255 255 / .04); }
  .block { display: grid; gap: 1.1rem; }
  .head h2 { margin: 0; font-size: 1.3rem; font-weight: 700; }
  .head p { margin: .4rem 0 0; color: #a9bbdb; font-size: .94rem; line-height: 1.55; }
  .head b { color: #fff; }
  .slots { border: 1px solid rgb(255 255 255 / .09); border-radius: 16px; padding: 1.1rem 1.3rem; display: grid; gap: .7rem; background: rgb(255 255 255 / .03); }
  .slots h3 { margin: 0; font-size: 1rem; }
  .slots ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .6rem; }
  .slots li { display: grid; gap: .1rem; padding: .8rem 1rem; border: 1px solid rgb(255 255 255 / .12); border-radius: 12px; background: rgb(47 123 255 / .08); }
  .slots li.full { opacity: .55; }
  .slots li b { color: #fff; }
  .slots li span { color: #8fa6d1; font-size: .82rem; }
  .slots li em { font-style: normal; font-size: .8rem; font-weight: 700; color: #8ff0bb; }
  .slots li.full em { color: #ffb4b4; }
  .soft { margin: 0; color: #8fa6d1; font-size: .86rem; }
  .notice { margin: 0; }
  @media (max-width: 40rem) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .btn { width: 100%; } }
</style>
