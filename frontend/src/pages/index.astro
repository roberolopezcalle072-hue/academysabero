---
import BaseLayout from '../shared/presentation/BaseLayout.astro';
import Icon from '../features/landing/Icon.astro';
import Testimonials from '../features/landing/Testimonials.astro';
import { hero, about, services, vision, whatsappUrl } from '../features/landing/content';
import { loadProgram } from '../features/learning/infrastructure/learning-api';

const result = await loadProgram();
const program = result.status === 'ok' ? result.value : null;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
const accents = ['#0b7bff', '#16a34a', '#6b3fd4', '#f08a24', '#0a8aa8', '#d4183d'];
const price = program?.launch_price != null && program.currency
  ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: program.currency }).format(program.launch_price)
  : null;
---
<BaseLayout title="Formación profesional" description="SABERO Academy: formación práctica en tecnología para tu negocio. Agentes de IA, automatización de ventas, WhatsApp, Meta, mini CRM y creación de webs. Campus privado con sesiones en vivo.">
  <section class="hero">
    <div class="shell hero-content">
      <div class="stack hero-copy">
        <p class="kicker-blue">SABERO ACADEMY</p>
        <h1><span class="grad">{program?.title ?? hero.title}</span></h1>
        <p class="intro">{program?.introduction ?? hero.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href="/ingresar">Acceder al campus <span aria-hidden="true">→</span></a>
          <a class="story" href="#nosotros"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" aria-hidden="true"><path d="M7 5v14l12-7z" /></svg>Conoce la academia</a>
        </div>
      </div>
      <div class="hero-visual">
        {program?.welcome_drive_file_id ? (
          <iframe
            title="Video de bienvenida"
            src={`https://drive.google.com/file/d/${encodeURIComponent(program.welcome_drive_file_id)}/preview`}
            referrerpolicy="no-referrer"
            loading="lazy"
            allowfullscreen
          ></iframe>
        ) : (
          <div class="blob-stage">
            <span class="blob blob-blue" aria-hidden="true"></span>
            <span class="blob blob-pink" aria-hidden="true"></span>
            <img class="blob-photo" src="/images/agente-ia-hero.webp" alt="Alumnos aprendiendo a crear un agente de IA de ventas con SABERO Academy" width="760" height="900" fetchpriority="high" />
            <span class="chip chip-dark">Tecnología en acción</span>
            <span class="chip chip-card chip-top"><span class="chip-ico" aria-hidden="true">&lt;/&gt;</span><span><strong>Lead nuevo</strong><small>Atendido por WhatsApp</small></span></span>
            <span class="chip chip-card chip-bottom" aria-hidden="true"><i class="dot"></i><span class="ln"><b></b><b></b><b class="s"></b></span></span>
          </div>
        )}
      </div>
    </div>
  </section>

  <section id="nosotros" class="band" aria-labelledby="t-nosotros">
    <div class="shell about">
      <div class="stack">
        <p class="kicker">{about.kicker}</p>
        <h2 id="t-nosotros">{about.title}</h2>
        {about.paragraphs.map(t => <p class="lead">{t}</p>)}
      </div>
      <ul class="stats">
        {about.stats.map((s, i) => <li style={`--c:${['#0b7bff', '#f08a24', '#16a34a'][i % 3]}`}><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="servicios" class="band alt" aria-labelledby="t-servicios">
    <div class="shell stack">
      <p class="kicker">Servicios</p>
      <h2 id="t-servicios">Todo lo que aprenderás a construir</h2>
      <div class="cards">
        {services.map((s, i) => (
          <article class="card" style={`--c:${accents[i % accents.length]}`}>
            <span class="icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="vision" class="band" aria-labelledby="t-vision">
    <div class="shell vision">
      <div class="stack">
        <p class="kicker">{vision.kicker}</p>
        <h2 id="t-vision">{vision.title}</h2>
        <p class="lead">{vision.text}</p>
      </div>
      <ul class="values">
        {vision.values.map((v, i) => <li style={`--c:${['#0b7bff', '#d4183d', '#16a34a'][i % 3]}`}><h3>{v.title}</h3><p>{v.text}</p></li>)}
      </ul>
    </div>
  </section>

  {program && (
    <section id="programa" class="band" aria-labelledby="formacion">
      <div class="shell stack overview">
        <div class="formation">
          <div class="stack">
            <p class="kicker">Programa</p>
            <h2 id="formacion">La formación</h2>
            <p class="copy">{program.description}</p>
          </div>
          <dl>
            <div><dt>Duración</dt><dd>{program.duration_text}</dd></div>
            {price && <div><dt>Precio de lanzamiento</dt><dd>{price}</dd></div>}
          </dl>
        </div>
        {program.benefits.length > 0 && <div class="stack benefits">
          <h3>Beneficios del programa</h3>
          <ul>{program.benefits.map(benefit => <li>{benefit}</li>)}</ul>
        </div>}
        <div id="inscripcion" class="stack registration">
          <h3>Inscripción</h3>
          <p class="copy">{program.registration_text}</p>
          <a class="button primary" href={program.registration_url}>Solicitar inscripción</a>
        </div>
      </div>
    </section>
  )}

  <section id="comentarios" class="band alt" aria-labelledby="t-comentarios">
    <div class="shell wide">
      <Testimonials />
    </div>
  </section>

  <section id="contacto" class="band cta" aria-labelledby="t-cta">
    <div class="shell stack centered">
      <h2 id="t-cta">¿Listo para empezar?</h2>
      <p class="lead">Ingresa al campus con tu cuenta de Google autorizada o escríbenos para resolver tus dudas.</p>
      <div class="hero-actions">
        <a class="button primary" href="/ingresar">Acceder al campus <span aria-hidden="true">→</span></a>
        {whatsappUrl && <a class="button ghost" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp</a>}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  /* Héroe claro con imagen en forma orgánica y chips flotantes */
  .hero { background: #f8fafc; border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero-content { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(3rem, 6vw, 5.5rem); }
  .hero-copy { max-width: 42rem; gap: 1.5rem; }
  .kicker-blue { color: var(--blue); font-size: .8rem; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 4.4rem); letter-spacing: -.04em; line-height: 1.05; }
  .grad { background: linear-gradient(95deg, #e5252f 0%, #a63a7c 45%, #3f4fc9 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .intro { color: var(--muted); font-size: 1.12rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .story { display: inline-flex; align-items: center; gap: .6rem; color: var(--navy); font-weight: 600; text-decoration: none; }
  .story svg { color: var(--blue); }
  .story:hover { color: var(--blue); }
  .hero-visual { width: 100%; }
  iframe { width: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--line); background: var(--white); box-shadow: var(--shadow); }

  .blob-stage { position: relative; width: min(100%, 36rem); aspect-ratio: 5 / 6; margin-inline: auto; }
  .blob { position: absolute; z-index: 0; }
  .blob-blue { left: -3%; top: 8%; width: 58%; height: 62%; background: linear-gradient(160deg, #3b8bff, #6fb2ff); }
  .blob-pink { right: -3%; bottom: 4%; width: 36%; height: 38%; background: #f4a3ad; opacity: .9; }
  .blob-photo { position: absolute; z-index: 1; left: 8%; top: 4%; width: 84%; height: 92%; object-fit: cover; object-position: 30% center; border: 6px solid #fff; box-shadow: 0 24px 50px rgb(7 27 53 / .22); }
  .chip { position: absolute; z-index: 2; }
  .chip-dark { top: 0; left: -2%; background: var(--navy); color: #fff; font-weight: 700; font-size: .85rem; padding: .7rem 1.1rem; box-shadow: 0 10px 24px rgb(7 27 53 / .3); }
  .chip-card { background: #fff; border: 1px solid var(--line); box-shadow: 0 14px 32px rgb(7 27 53 / .16); display: flex; align-items: center; gap: .75rem; padding: .8rem 1rem; }
  .chip-top { top: 9%; right: -6%; }
  .chip-top span:last-child { display: grid; line-height: 1.25; }
  .chip-top strong { color: var(--navy); font-size: .92rem; }
  .chip-top small { color: var(--muted); font-size: .78rem; }
  .chip-ico { display: grid; place-items: center; width: 40px; height: 40px; background: #eaf3ff; color: var(--blue); font-weight: 800; font-size: .8rem; }
  .chip-bottom { bottom: 6%; left: -4%; padding: 1rem 1.25rem; }
  .dot { width: 10px; height: 10px; background: var(--red); }
  .ln { display: grid; gap: .35rem; }
  .ln b { display: block; height: 4px; width: 80px; background: #dfe7ee; }
  .ln b.s { width: 52px; }

  .band { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
  .band.alt { background: var(--light); }
  .band.dark { background: var(--navy); color: var(--white); }
  .band.dark h2, .band.dark h3 { color: var(--white); }
  .band.dark .kicker { color: var(--cyan); }
  .band h2 { max-width: 28ch; }
  .lead { font-size: 1.1rem; color: var(--muted); }
  .band.dark .lead, .band.dark p { color: #c9d7e6; }

  .about { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .stats li { border: 1px solid var(--line); background: var(--white); padding: 1rem 1.25rem; display: grid; }
  .stats strong { font-size: 1.9rem; font-weight: 800; color: var(--navy); letter-spacing: -.02em; }
  .stats span { color: var(--muted); }

  .cards { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1rem; }
  .card { background: var(--white); border: 1px solid var(--line); padding: 1.75rem; display: grid; gap: .75rem; align-content: start; transition: border-color .25s ease, box-shadow .25s ease; }
  .card:hover { border-color: var(--blue); box-shadow: var(--shadow); }
  .icon { display: grid; place-items: center; width: 52px; height: 52px; background: #eaf3ff; color: var(--blue); }
  .card p { color: var(--muted); }

  .vision { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .values { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .values li { border-top: 1px solid #30455d; padding-top: 1rem; }
  .values h3 { color: var(--cyan); margin-bottom: .25rem; }

  .overview { gap: 3rem; }
  .formation { width: 100%; display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; }
  dl { margin: 0; display: grid; gap: 1rem; }
  dl div, .benefits { border-top: 1px solid var(--line); padding-top: 1rem; }
  dt { color: var(--muted); }
  dd { margin: .2rem 0 0; font-size: 1.2rem; font-weight: 800; color: var(--navy); }
  .benefits { width: 100%; }
  .benefits ul { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .75rem 3rem; margin: 0; padding-left: 1.25rem; }
  .registration { width: 100%; background: var(--light); border: 1px solid var(--line); padding: clamp(1.25rem, 4vw, 2.5rem); }
  .copy { white-space: pre-line; }

  .cta { background: linear-gradient(160deg, #071b35 30%, #0a2a52 100%); color: var(--white); }
  .ghost { color: var(--navy); border-color: #c3d2de; background: var(--white); }
  .ghost:hover { border-color: var(--blue); color: var(--blue); }
  .cta h2 { color: var(--white); }
  .cta .lead { color: #c9d7e6; }
  .centered { justify-items: center; text-align: center; }
  .centered h2 { max-width: none; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: rise .8s ease both; }
    @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 64rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 48rem) {
    .hero-content, .about, .vision, .formation, .benefits ul, .cards { grid-template-columns: minmax(0, 1fr); }
    .blob-stage { width: min(88%, 24rem); }
    .chip-top { right: -2%; }
  }

  /* ===== Estilo suave y elegante (esquinas redondeadas finas, sin bandas oscuras) ===== */
  .hero-copy .button { padding-inline: 1.6rem; }
  .stats li { border-radius: 16px; box-shadow: 0 6px 20px rgb(7 27 53 / .05); }
  .card { border-radius: 18px; }
  .card:hover { box-shadow: 0 16px 36px rgb(7 27 53 / .10); }
  .icon { border-radius: 14px; }
  .registration { border-radius: 16px; }
  iframe { border-radius: 18px; }

  .vision { align-items: start; }
  .values { gap: 1rem; }
  .values li { background: var(--light); border: 1px solid var(--line); border-radius: 16px; padding: 1.25rem 1.5rem; }
  .values h3 { color: var(--navy); margin-bottom: .35rem; }
  #vision .lead, #vision p { color: var(--muted); }

  .cta { background: #f8fafc; color: var(--navy); border-top: 1px solid var(--line); }
  .cta h2 { color: var(--navy); }
  .cta .lead { color: var(--muted); }

  .blob-blue { border-radius: 58% 42% 52% 48% / 48% 55% 45% 52%; }
  .blob-pink { border-radius: 50% 50% 45% 55% / 55% 45% 55% 45%; }
  .blob-photo { border: 0; border-radius: 42% 58% 46% 54% / 36% 38% 62% 64%; left: 9%; top: 0; width: 82%; height: 100%; }
  .chip-dark { border-radius: 999px; }
  .chip-card { border: 0; border-radius: 14px; }
  .chip-ico { border-radius: 10px; }
  .dot { border-radius: 50%; }
  .ln b { border-radius: 2px; }

  /* ===== Escala compacta ===== */
  .hero-content { padding-block: clamp(1.75rem, 3.5vw, 3rem); gap: clamp(1.5rem, 3vw, 3rem); }
  .hero-copy { gap: 1rem; max-width: 34rem; }
  .hero h1 { font-size: clamp(1.9rem, 3.4vw, 3rem); }
  .intro { font-size: 1rem; }
  .kicker-blue { font-size: .72rem; }
  .blob-stage { width: min(100%, 25rem); }
  .band { padding-block: clamp(2rem, 4vw, 3.25rem); }
  .band h2 { max-width: 30ch; }
  .lead { font-size: 1rem; }
  .about, .vision { gap: clamp(1.5rem, 3vw, 3rem); }
  .stats { gap: .7rem; }
  .stats li { padding: .75rem 1rem; }
  .stats strong { font-size: 1.4rem; }
  .cards { gap: .9rem; margin-top: .5rem; }
  .card { padding: 1.1rem 1.25rem; gap: .5rem; border-radius: 14px; }
  .icon { width: 40px; height: 40px; border-radius: 12px; }
  .values li { padding: .9rem 1.1rem; border-radius: 14px; }
  .overview { gap: 2rem; }

  /* ===== Nosotros, Servicios y Visión: más holgadas ===== */
  #nosotros, #servicios, #vision { padding-block: clamp(3rem, 6.5vw, 5.5rem); }
  #nosotros h2, #servicios h2, #vision h2 { font-size: clamp(1.7rem, 2.9vw, 2.5rem); }
  #nosotros .lead, #vision .lead { font-size: 1.08rem; line-height: 1.7; }
  #nosotros .stack, #vision .stack { gap: 1.1rem; }
  #nosotros .about, #vision .vision { gap: clamp(2rem, 4.5vw, 4.5rem); }
  #nosotros .stats { gap: 1rem; }
  #nosotros .stats li { padding: 1.1rem 1.4rem; }
  #nosotros .stats strong { font-size: 1.8rem; }
  #servicios .cards { gap: 1.25rem; margin-top: 1rem; }
  #servicios .card { padding: 1.6rem 1.6rem 1.7rem; gap: .7rem; }
  #servicios .icon { width: 48px; height: 48px; }
  #servicios .card h3 { font-size: 1.12rem; }
  #servicios .card p { font-size: 1rem; line-height: 1.6; }
  #vision .values { gap: 1.1rem; }
  #vision .values li { padding: 1.3rem 1.5rem; }
  #vision .values h3 { font-size: 1.12rem; }
  #vision .values p { font-size: 1rem; line-height: 1.6; }

  /* Comentarios: contenedor más ancho para que las 5 tarjetas respiren */
  #comentarios { padding-block: clamp(3rem, 6.5vw, 5.5rem); }
  .shell.wide { width: min(100% - clamp(2.5rem, 5vw, 5rem), 96rem); }

  /* Servicios con color propio */
  #servicios .card { background: color-mix(in srgb, var(--c) 6%, #fff); border: 1px solid color-mix(in srgb, var(--c) 24%, #fff); }
  #servicios .card:hover { border-color: var(--c); box-shadow: 0 16px 34px color-mix(in srgb, var(--c) 22%, transparent); transform: translateY(-3px); }
  #servicios .icon { background: linear-gradient(145deg, var(--c), color-mix(in srgb, var(--c) 62%, #000)); color: #fff; box-shadow: 0 8px 18px color-mix(in srgb, var(--c) 35%, transparent); }
  #servicios .card h3 { color: var(--navy); }
  #servicios .card { transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease; }

  /* Nosotros: cifras con color y un poco más de aire */
  #nosotros .about { gap: clamp(2.25rem, 5vw, 5rem); }
  #nosotros .stack { gap: 1.25rem; }
  #nosotros .lead { line-height: 1.75; }
  #nosotros .stats { gap: 1.1rem; }
  #nosotros .stats li { padding: 1.3rem 1.6rem; background: color-mix(in srgb, var(--c) 6%, #fff); border: 1px solid color-mix(in srgb, var(--c) 24%, #fff); gap: .15rem; transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease; }
  #nosotros .stats li:hover { border-color: var(--c); box-shadow: 0 14px 30px color-mix(in srgb, var(--c) 20%, transparent); transform: translateY(-2px); }
  #nosotros .stats strong { color: var(--c); }

  /* Visión: tarjetas con color y un poco más de aire */
  #vision .vision { gap: clamp(2.25rem, 5vw, 5rem); }
  #vision .stack { gap: 1.25rem; }
  #vision .lead { line-height: 1.75; }
  #vision .values { gap: 1.1rem; }
  #vision .values li { padding: 1.3rem 1.6rem; background: color-mix(in srgb, var(--c) 6%, #fff); border: 1px solid color-mix(in srgb, var(--c) 24%, #fff); transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease; }
  #vision .values li:hover { border-color: var(--c); box-shadow: 0 14px 30px color-mix(in srgb, var(--c) 20%, transparent); transform: translateY(-2px); }
  #vision .values h3 { color: var(--c); }
  #vision .kicker { color: var(--red); }
</style>
