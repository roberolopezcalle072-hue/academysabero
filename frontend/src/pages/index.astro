---
import BaseLayout from '../shared/presentation/BaseLayout.astro';
import Icon from '../features/landing/Icon.astro';
import Testimonials from '../features/landing/Testimonials.astro';
import { about, services, vision, whatsappUrl } from '../features/landing/content';
import { loadProgram } from '../features/learning/infrastructure/learning-api';

const result = await loadProgram();
const program = result.status === 'ok' ? result.value : null;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
const price = program?.launch_price != null && program.currency
  ? new Intl.NumberFormat('es-PE', { style: 'currency', currency: program.currency }).format(program.launch_price)
  : null;
---
<BaseLayout title="Formación profesional" description="SABERO Academy: campus privado de formación de SABERO Consulting con cursos, sesiones en vivo, recursos y acompañamiento personalizado.">
  <section class="hero">
    <div class="shell hero-content">
      <div class="stack hero-copy">
        <p class="kicker">SABERO Consulting</p>
        <h1>{program?.title ?? 'SABERO Academy'}</h1>
        <p class="intro">{program?.introduction ?? 'Campus privado de formación de SABERO Consulting. Aprende con método, en vivo y con acompañamiento real.'}</p>
        <div class="hero-actions">
          <a class="button hero-action" href="/ingresar">Acceder al campus</a>
          <a class="button outline" href="#servicios">Conoce nuestros servicios</a>
        </div>
      </div>
      {program?.welcome_drive_file_id ? (
        <iframe
          title="Video de bienvenida"
          src={`https://drive.google.com/file/d/${encodeURIComponent(program.welcome_drive_file_id)}/preview`}
          referrerpolicy="no-referrer"
          loading="lazy"
          allowfullscreen
        ></iframe>
      ) : <svg class="art" viewBox="0 0 400 380" role="img" aria-label="Birrete de graduación sobre un agente de inteligencia artificial" fill="none" stroke-linejoin="miter" stroke-linecap="square">
          <g stroke="#466680" stroke-width="1">
            <path d="M120 255H48M280 255H352M200 305V345M48 255V200M352 255V200M200 345H110M200 345H290" />
          </g>
          <g stroke="#466680" stroke-width="1" fill="#071b35">
            <rect x="40" y="192" width="16" height="16" /><rect x="344" y="192" width="16" height="16" />
            <rect x="102" y="337" width="16" height="16" /><rect x="282" y="337" width="16" height="16" />
          </g>
          <g stroke="#25c5e8" stroke-width="1.5">
            <path d="M200 38 335 92 200 146 65 92Z" fill="#0e3560" />
            <path d="M118 118V170H282V118" />
            <path d="M335 92V160" /><rect x="329" y="160" width="12" height="22" fill="#25c5e8" />
          </g>
          <g stroke="#25c5e8" stroke-width="1.5">
            <rect x="118" y="170" width="164" height="135" fill="#0b2a4d" fill-opacity=".6" />
            <rect x="100" y="215" width="18" height="45" /><rect x="282" y="215" width="18" height="45" />
          </g>
          <g fill="#25c5e8">
            <rect x="152" y="212" width="32" height="26" /><rect x="216" y="212" width="32" height="26" />
          </g>
          <path d="M160 272H240M160 284H215" stroke="#087cf0" stroke-width="1.5" />
        </svg>}
    </div>
  </section>

  <section id="nosotros" class="band" aria-labelledby="t-nosotros">
    <div class="shell about">
      <div class="stack">
        <p class="kicker">{about.kicker}</p>
        <h2 id="t-nosotros">{about.title}</h2>
        {about.paragraphs.map(t => <p class="lead">{t}</p>)}
      </div>
      <ul class="stats">
        {about.stats.map(s => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section id="servicios" class="band alt" aria-labelledby="t-servicios">
    <div class="shell stack">
      <p class="kicker">Servicios</p>
      <h2 id="t-servicios">Todo lo que necesitas para formarte</h2>
      <div class="cards">
        {services.map(s => (
          <article class="card">
            <span class="icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="vision" class="band dark" aria-labelledby="t-vision">
    <div class="shell vision">
      <div class="stack">
        <p class="kicker">{vision.kicker}</p>
        <h2 id="t-vision">{vision.title}</h2>
        <p class="lead">{vision.text}</p>
      </div>
      <ul class="values">
        {vision.values.map(v => <li><h3>{v.title}</h3><p>{v.text}</p></li>)}
      </ul>
    </div>
  </section>

  {program && (
    <section id="programa" class="band" aria-labelledby="formacion">
      <div class="shell stack overview">
        <div class="formation">
          <div class="stack">
            <p class="kicker">Programa</p>
            <h2 id="formacion">La formación</h2>
            <p class="copy">{program.description}</p>
          </div>
          <dl>
            <div><dt>Duración</dt><dd>{program.duration_text}</dd></div>
            {price && <div><dt>Precio de lanzamiento</dt><dd>{price}</dd></div>}
          </dl>
        </div>
        {program.benefits.length > 0 && <div class="stack benefits">
          <h3>Beneficios del programa</h3>
          <ul>{program.benefits.map(benefit => <li>{benefit}</li>)}</ul>
        </div>}
        <div id="inscripcion" class="stack registration">
          <h3>Inscripción</h3>
          <p class="copy">{program.registration_text}</p>
          <a class="button primary" href={program.registration_url}>Solicitar inscripción</a>
        </div>
      </div>
    </section>
  )}

  <section id="comentarios" class="band alt" aria-labelledby="t-comentarios">
    <div class="shell stack">
      <p class="kicker">Comentarios</p>
      <h2 id="t-comentarios">Lo que dicen nuestros alumnos</h2>
      <Testimonials />
    </div>
  </section>

  <section class="band cta" aria-labelledby="t-cta">
    <div class="shell stack centered">
      <h2 id="t-cta">¿Listo para empezar?</h2>
      <p class="lead">Ingresa al campus con tu cuenta de Google autorizada o escríbenos para más información.</p>
      <div class="hero-actions">
        <a class="button hero-action" href="/ingresar">Acceder al campus</a>
        {whatsappUrl && <a class="button outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Hablar por WhatsApp</a>}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { background: radial-gradient(1200px 500px at 85% -10%, #0e3560 0%, transparent 60%), var(--navy); color: var(--white); }
  .hero-content { display: grid; grid-template-columns: 1.07fr .93fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4.5rem, 10vw, 9rem); }
  .hero h1 { font-family: ui-serif, Georgia, 'Times New Roman', serif; font-weight: 600; letter-spacing: -.03em; }
  .hero .kicker { color: var(--cyan); }
  .intro { color: #c9d7e6; font-size: 1.15rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero-action { background: var(--cyan); color: var(--navy); }
  .hero-action:hover { background: var(--white); }
  iframe { width: 100%; aspect-ratio: 16 / 9; border: 1px solid #466680; }
  .art { justify-self: end; width: min(100%, 26rem); height: auto; }
  .geometry { position: relative; justify-self: end; width: min(100%, 19rem); aspect-ratio: 1; border: 1px solid #466680; }
  .geometry::before, .geometry::after, .geometry span { content: ""; position: absolute; }
  .geometry::before { inset: 15% 0 0 15%; border-top: 2px solid var(--cyan); border-left: 2px solid var(--cyan); }
  .geometry::after { inset: 34% 15% 0 34%; background: #0e3560; border-top: 1px solid var(--blue); border-left: 1px solid var(--blue); }
  .geometry span { z-index: 1; inset: 53% 0 0 53%; border-top: 1px solid var(--cyan); border-left: 1px solid var(--cyan); }

  .band { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
  .band.alt { background: var(--light); }
  .band.dark { background: var(--navy); color: var(--white); }
  .band.dark .kicker { color: var(--cyan); }
  .band h2 { font-family: ui-serif, Georgia, 'Times New Roman', serif; font-weight: 600; letter-spacing: -.02em; max-width: 24ch; }
  .lead { font-size: 1.1rem; color: var(--muted); }
  .band.dark .lead, .band.dark p { color: #c9d7e6; }

  .about { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .stats li { border-left: 3px solid var(--cyan); padding: .4rem 0 .4rem 1.25rem; display: grid; }
  .stats strong { font-family: ui-serif, Georgia, serif; font-size: 2rem; color: var(--navy); }
  .stats span { color: var(--muted); }

  .cards { width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1rem; }
  .cards.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .card { background: var(--white); border: 1px solid var(--line); border-radius: 0; padding: 1.75rem; display: grid; gap: .75rem; align-content: start; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .card:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px var(--cyan); border-color: var(--cyan); }
  .icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 0; background: var(--navy); color: var(--cyan); }
  .card h3 { font-size: 1.15rem; }
  .card p { color: var(--muted); }
  .quote { margin: 0; }
  .quote blockquote { margin: 0; font-family: ui-serif, Georgia, serif; font-size: 1.1rem; }
  .quote figcaption { display: grid; color: var(--muted); font-size: .9rem; }
  .invite { width: 100%; max-width: 44rem; justify-items: start; }

  .vision { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .values { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .values li { border-top: 1px solid #30455d; padding-top: 1rem; }
  .values h3 { color: var(--cyan); margin-bottom: .25rem; }

  .overview { gap: 3rem; }
  .formation { width: 100%; display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; }
  dl { margin: 0; display: grid; gap: 1rem; }
  dl div, .benefits { border-top: 1px solid var(--line); padding-top: 1rem; }
  dt { color: var(--muted); }
  dd { margin: .2rem 0 0; font-size: 1.2rem; font-weight: 750; }
  .benefits { width: 100%; }
  .benefits ul { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .75rem 3rem; margin: 0; padding-left: 1.25rem; }
  .registration { width: 100%; background: var(--light); border-left: 3px solid var(--blue); padding: clamp(1.25rem, 4vw, 2.5rem); }
  .copy { white-space: pre-line; }

  .cta { background: radial-gradient(900px 400px at 15% 110%, #0e3560 0%, transparent 60%), var(--navy); color: var(--white); }
  .cta .lead { color: #c9d7e6; }
  .centered { justify-items: center; text-align: center; }
  .centered h2 { max-width: none; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: rise .8s ease both; }
    @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 64rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cards.three { grid-template-columns: 1fr; } }
  @media (max-width: 48rem) {
    .hero-content, .about, .vision, .formation, .benefits ul, .cards { grid-template-columns: 1fr; }
    .art { justify-self: center; width: min(80%, 18rem); }
  }
</style>
