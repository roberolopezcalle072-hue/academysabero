---
interface Props {
  /** Fecha (AAAA-MM-DD) de cada clase. */
  classes: { class_no: number; date: string | null }[];
  holidays: { day: string; label: string }[];
  /** Clases ya completadas o ejecutadas (se pintan distinto). */
  done?: number[];
  /** Número de la próxima clase (se resalta). */
  next?: number | null;
}
const { classes, holidays, done = [], next = null } = Astro.props;

const dated = classes.filter((c): c is { class_no: number; date: string } => Boolean(c.date)).sort((a, b) => a.date.localeCompare(b.date));
const byDay = new Map(dated.map((c) => [c.date, c.class_no]));
const holiday = new Map(holidays.map((h) => [h.day, h.label]));
const doneSet = new Set(done);

// Meses desde la primera clase (o feriado) hasta la última.
const days = [...dated.map((c) => c.date), ...holidays.map((h) => h.day)].sort();
const first = days[0] ? new Date(`${days[0]}T12:00:00Z`) : null;
const last = days.length ? new Date(`${days[days.length - 1]}T12:00:00Z`) : null;
const months: { year: number; month: number }[] = [];
if (first && last) {
  const cur = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth(), 1));
  while (cur <= last) { months.push({ year: cur.getUTCFullYear(), month: cur.getUTCMonth() }); cur.setUTCMonth(cur.getUTCMonth() + 1); }
}
const monthName = new Intl.DateTimeFormat('es-PE', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const iso = (y: number, m: number, d: number) => `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Lima' }).format(new Date());
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const grids = months.map(({ year, month }) => {
  const total = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
  const offset = (new Date(Date.UTC(year, month, 1)).getUTCDay() + 6) % 7; // lunes = 0
  const cells: ({ d: number; date: string } | null)[] = [...Array(offset).fill(null), ...Array.from({ length: total }, (_, i) => ({ d: i + 1, date: iso(year, month, i + 1) }))];
  while (cells.length % 7) cells.push(null);
  return { title: cap(monthName.format(new Date(Date.UTC(year, month, 1)))), cells };
});
---
{grids.length > 0 && (
  <section class="cal" aria-label="Calendario del curso">
    <div class="months">
      {grids.map((g) => (
        <div class="month">
          <h3>{g.title}</h3>
          <div class="grid" role="grid">
            {['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((w, i) => <span class={`wd ${i > 4 ? 'we' : ''}`} aria-hidden="true">{w}</span>)}
            {g.cells.map((c) => {
              if (!c) return <span class="empty"></span>;
              const classNo = byDay.get(c.date);
              const off = holiday.get(c.date);
              const cls = ['day'];
              if (classNo) cls.push('class');
              if (classNo && doneSet.has(classNo)) cls.push('done');
              if (classNo && classNo === next) cls.push('next');
              if (off) cls.push('off');
              if (c.date === todayIso) cls.push('today');
              const label = classNo ? `Clase ${classNo}` : off ? off : '';
              return (
                <span class={cls.join(' ')} title={label || undefined} aria-label={label ? `${c.d}: ${label}` : String(c.d)}>
                  <b>{c.d}</b>
                  {classNo && <small>{classNo}</small>}
                </span>
              );
            })}
          </div>
        </div>
      ))}
    </div>
    <ul class="legend">
      <li><i class="k class"></i>Clase en vivo</li>
      <li><i class="k off"></i>Feriado / receso{holidays.length ? ` (${holidays.length} días)` : ''}</li>
      <li><i class="k today"></i>Hoy</li>
    </ul>
  </section>
)}
<style>
  .cal { display: grid; gap: .9rem; }
  .months { display: grid; grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr)); gap: 1rem; }
  .month { border: 1px solid rgb(255 255 255 / .09); border-radius: 16px; padding: 1rem 1.1rem 1.1rem; background: linear-gradient(180deg, rgb(255 255 255 / .045), rgb(255 255 255 / .02)); }
  h3 { margin: 0 0 .7rem; font-size: .98rem; font-weight: 650; color: #fff; }
  .grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: .3rem; }
  .wd { text-align: center; font-size: .68rem; font-weight: 700; letter-spacing: .08em; color: #6f87b8; padding-bottom: .2rem; }
  .wd.we { color: #4b6197; }
  .empty { aspect-ratio: 1.3; }
  .day { position: relative; aspect-ratio: 1.3; display: grid; place-items: center; border-radius: 10px; font-size: .82rem; color: #8fa6d1; border: 1px solid transparent; }
  .day b { font-weight: 500; }
  .day small { position: absolute; bottom: 1px; right: 4px; font-size: .56rem; font-weight: 800; opacity: .9; }
  .day.class { background: rgb(47 123 255 / .22); border-color: rgb(92 200 255 / .45); color: #fff; }
  .day.class b { font-weight: 700; }
  .day.class.done { background: rgb(53 208 127 / .18); border-color: rgb(53 208 127 / .5); }
  .day.class.next { background: linear-gradient(180deg, #3b9bff, #1c63ea); border-color: transparent; box-shadow: 0 6px 16px -6px rgb(47 123 255 / .9); }
  .day.off { background: repeating-linear-gradient(135deg, rgb(255 193 70 / .16) 0 5px, rgb(255 193 70 / .07) 5px 10px); border-color: rgb(255 193 70 / .4); color: #ffd98a; }
  .day.today { outline: 2px solid #5cc8ff; outline-offset: 1px; }
  .legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; font-size: .8rem; color: #8fa6d1; }
  .legend li { display: flex; align-items: center; gap: .5rem; }
  .k { width: .95rem; height: .95rem; border-radius: 5px; border: 1px solid transparent; display: inline-block; }
  .k.class { background: rgb(47 123 255 / .35); border-color: rgb(92 200 255 / .6); }
  .k.off { background: repeating-linear-gradient(135deg, rgb(255 193 70 / .4) 0 3px, rgb(255 193 70 / .15) 3px 6px); border-color: rgb(255 193 70 / .5); }
  .k.today { border: 2px solid #5cc8ff; }
</style>
