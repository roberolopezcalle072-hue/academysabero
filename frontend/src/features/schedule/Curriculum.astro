---
import { lines } from './schedule-api';

interface Klass {
  class_no: number; topic_no: number; date: string | null; title: string; description: string;
  objectives: string; content: string; activity: string; outcome: string; duration_minutes: number;
}
interface Mod {
  week_no: number; title: string; objective: string; result: string; start: string | null; end: string | null;
  topics: { topic_no: number; title: string }[]; classes: Klass[];
}
interface Props { weeks: Mod[] }
const { weeks } = Astro.props;

const fmt = new Intl.DateTimeFormat('es-PE', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const day = (iso: string | null) => {
  if (!iso) return '';
  const t = fmt.format(new Date(`${iso}T12:00:00Z`)).replace(/\./g, '');
  return t.charAt(0).toUpperCase() + t.slice(1);
};
const long = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const range = (a: string | null, b: string | null) => (a && b ? `${long.format(new Date(`${a}T12:00:00Z`))} al ${long.format(new Date(`${b}T12:00:00Z`))}` : '');
---
<div class="mods">
  {weeks.map((m) => (
    <article class="mod">
      <header>
        <p class="eyebrow">Módulo {m.week_no}{range(m.start, m.end) ? ` · ${range(m.start, m.end)}` : ''}</p>
        <h3>{m.title}</h3>
        <p class="obj"><b>Objetivo:</b> {m.objective}</p>
      </header>
      {m.topics.map((t) => (
        <section class="topic">
          <h4>Tema {t.topic_no} · {t.title}</h4>
          <ol>
            {m.classes.filter((c) => c.topic_no === t.topic_no).map((c) => (
              <li>
                <details>
                  <summary>
                    <span class="num">{c.class_no}</span>
                    <span class="info"><b>{c.title}</b><small>{day(c.date)} · 2 h en vivo</small></span>
                  </summary>
                  <div class="body">
                    <p>{c.description}</p>
                    {lines(c.objectives).length > 0 && <p><b>Objetivo:</b> {lines(c.objectives).join(' ')}</p>}
                    <p class="k">Qué verás</p>
                    <ul>{lines(c.content).map((l) => <li>{l}</li>)}</ul>
                    <p><b>Actividad:</b> {c.activity}</p>
                    <p><b>Entregable:</b> {c.outcome}</p>
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      ))}
      {m.result && <p class="result"><b>Resultado del módulo:</b> {m.result}</p>}
    </article>
  ))}
</div>
<style>
  .mods { display: grid; gap: 1.2rem; }
  .mod { border: 1px solid rgb(255 255 255 / .09); border-radius: 18px; padding: 1.5rem 1.6rem; display: grid; gap: 1rem; background: linear-gradient(180deg, rgb(255 255 255 / .045), rgb(255 255 255 / .02)); box-shadow: 0 18px 40px -28px rgb(0 0 0 / .8); }
  .eyebrow { margin: 0 0 .3rem; font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #5cc8ff; }
  h3 { margin: 0; font-size: 1.25rem; font-weight: 700; letter-spacing: -.01em; color: #fff; }
  .obj { margin: .5rem 0 0; color: #a9bbdb; font-size: .93rem; line-height: 1.55; }
  .topic h4 { margin: 0 0 .5rem; font-size: .88rem; font-weight: 650; color: #cfe0ff; letter-spacing: .01em; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  details { border: 1px solid rgb(255 255 255 / .08); border-radius: 12px; background: rgb(255 255 255 / .02); }
  summary { display: flex; align-items: center; gap: .8rem; padding: .7rem .9rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: rgb(255 255 255 / .04); border-radius: 12px; }
  .num { flex: none; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid rgb(255 255 255 / .2); font-weight: 800; font-size: .82rem; color: #fff; }
  .info { display: grid; gap: .1rem; min-width: 0; }
  .info b { color: #fff; font-weight: 650; font-size: .93rem; }
  .info small { color: #8fa6d1; font-size: .78rem; }
  .body { padding: .2rem 1rem 1rem 3.6rem; display: grid; gap: .55rem; }
  .body p { margin: 0; color: #c7d6f2; font-size: .9rem; line-height: 1.55; }
  .body b { color: #fff; }
  .k { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #8fa6d1; }
  .body ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .2rem; color: #c7d6f2; font-size: .88rem; }
  .result { margin: 0; padding: .9rem 1rem; border-radius: 12px; background: rgb(53 208 127 / .09); border: 1px solid rgb(53 208 127 / .3); color: #c9f5de; font-size: .92rem; line-height: 1.5; }
  .result b { color: #8ff0bb; }
  @media (max-width: 40rem) { .mod { padding: 1.15rem; border-radius: 16px; } .body { padding: .2rem .9rem 1rem; } }
</style>
