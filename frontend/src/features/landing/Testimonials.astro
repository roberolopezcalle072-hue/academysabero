---
import { testimonials, whatsappUrl } from './content';
const items = testimonials.slice(0, 8);
---
{items.length > 0 ? (
  <div class="carousel" data-carousel aria-roledescription="carrusel" aria-label="Comentarios de alumnos">
    <div class="track" data-track tabindex="0">
      {items.map((t, i) => (
        <figure class="slide" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${items.length}`}>
          <span class="mark" aria-hidden="true">“</span>
          <blockquote>{t.text}</blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{t.name.trim().charAt(0).toUpperCase()}</span>
            <span><strong>{t.name}</strong><small>{t.role}</small></span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="controls">
      <button type="button" class="nav" data-prev aria-label="Comentario anterior">‹</button>
      <div class="dots" data-dots>
        {items.map((_, i) => <button type="button" class="dot" data-dot={i} aria-label={`Ir al comentario ${i + 1}`}></button>)}
      </div>
      <button type="button" class="nav" data-next aria-label="Comentario siguiente">›</button>
    </div>
  </div>
) : (
  <div class="invite">
    <h3>Tu opinión construye esta academia</h3>
    <p>Estamos abriendo el campus. Si participas en la formación, tu experiencia aparecerá aquí.</p>
    {whatsappUrl && <a class="button primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    let index = 0;
    let timer: number | undefined;
    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    const mark = () => {
      const w = slides[0].getBoundingClientRect().width + 20;
      index = Math.min(slides.length - 1, Math.round(track.scrollLeft / w));
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
    };
    track.addEventListener('scroll', () => requestAnimationFrame(mark), { passive: true });
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce) timer = window.setInterval(() => go(index + 1), 6000); };
    const stop = () => window.clearInterval(timer);
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    mark(); start();
  });
</script>

<style>
  .carousel { width: 100%; }
  .track { display: flex; gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-block: .5rem 1rem; }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 calc((100% - 2.5rem) / 3); scroll-snap-align: start; margin: 0; background: var(--white); border: 1px solid var(--line); border-radius: 0; padding: 2rem 1.75rem; display: grid; gap: 1.25rem; align-content: space-between; position: relative; transition: box-shadow .25s ease, border-color .25s ease; }
  .slide:hover { box-shadow: 0 0 0 1px var(--cyan); border-color: var(--cyan); }
  .mark { font-family: ui-serif, Georgia, serif; font-size: 4rem; line-height: .6; color: var(--cyan); }
  blockquote { margin: 0; font-family: ui-serif, Georgia, serif; font-size: 1.1rem; color: var(--text); }
  figcaption { display: flex; align-items: center; gap: .75rem; }
  figcaption span:last-child { display: grid; }
  figcaption small { color: var(--muted); }
  .avatar { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 0; background: var(--navy); color: var(--cyan); font-weight: 700; }
  .controls { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: .5rem; }
  .nav { width: 44px; height: 44px; border-radius: 0; border: 1px solid var(--line); background: var(--white); color: var(--navy); font-size: 1.5rem; line-height: 1; }
  .nav:hover { border-color: var(--cyan); }
  .dots { display: flex; gap: .5rem; }
  .dot { width: 32px; height: 22px; padding: 10px 0; border-radius: 0; border: 0; background: #b9c8d4; background-clip: content-box; }
  .dot[aria-current="true"] { background: var(--blue); background-clip: content-box; padding: 9px 0; }
  .invite { background: var(--white); border: 1px solid var(--line); border-radius: 0; padding: 1.75rem; display: grid; gap: .75rem; justify-items: start; max-width: 44rem; }
  @media (max-width: 64rem) { .slide { flex-basis: calc((100% - 1.25rem) / 2); } }
  @media (max-width: 40rem) { .slide { flex-basis: 100%; } }
</style>
