---
import { testimonials, whatsappUrl } from './content';
const items = testimonials.slice(0, 8);
const hasSample = items.some((t) => t.sample);
const colors = ['#d4183d', '#0b7bff', '#0e8a6a', '#6b3fd4', '#0a2a52', '#c2570a', '#0a8aa8', '#a3156b'];
const initials = (name: string) => name.trim().split(/\s+/).slice(0, 2).map((w) => w.charAt(0).toUpperCase()).join('');
---
{items.length > 0 && (
  <div class="testi" data-carousel>
    <header class="head">
      <p class="kicker">Nuestros alumnos</p>
      <h2 id="t-comentarios">Lo que dicen quienes ya se forman con nosotros</h2>
      {hasSample && <p class="note">Comentarios ilustrativos de ejemplo</p>}
    </header>

    <div class="grid" data-grid aria-live="polite">
      {items.map((t, i) => (
        <figure class="tcard" data-card>
          <svg class="quote-ico" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="miter"><path d="M5 20v-5.5C5 10 8 7.5 12 7v3c-2 .5-3 1.800-3 4h3v6H5ZM18 20v-5.500c0-4.500 3-7 7-7.500v3c-2 .5-3 1.800-3 4h3v6h-7Z"/></svg>
          <blockquote>“{t.text}”</blockquote>
          <figcaption>
            {t.photo
              ? <img class="avatar" src={t.photo} alt={`Foto de ${t.name}`} width="56" height="56" loading="eager" decoding="async" />
              : <span class="avatar" style={`background:${colors[i % colors.length]}`} aria-hidden="true">{initials(t.name)}</span>}
            <span class="who"><strong>{t.name}</strong><small>{t.role}</small></span>
            {whatsappUrl && (
              <a class="wa" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              </a>
            )}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="controls">
      <button type="button" class="nav" data-prev aria-label="Comentarios anteriores">←</button>
      <p class="count" aria-hidden="true"><b data-cur>01</b> / {String(items.length).padStart(2, '0')}</p>
      <button type="button" class="nav" data-next aria-label="Comentarios siguientes">→</button>
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
    const cur = root.querySelector<HTMLElement>('[data-cur]');
    const total = cards.length;
    const perView = () => (innerWidth > 1200 ? 5 : innerWidth > 900 ? 3 : innerWidth > 600 ? 2 : 1);
    let start = 0;
    let timer: number | undefined;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const render = () => {
      const n = perView();
      const visible = new Set(Array.from({ length: n }, (_, k) => (start + k) % total));
      cards.forEach((c, i) => {
        const show = visible.has(i);
        c.hidden = !show;
        if (show) c.style.order = String((i - start + total) % total);
      });
      if (cur) cur.textContent = String(start + 1).padStart(2, '0');
    };
    const go = (i: number) => {
      start = (i + total) % total;
      if (!reduce) { grid.classList.remove('swap'); void grid.offsetWidth; grid.classList.add('swap'); }
      render();
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(start - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(start + 1));
    const run = () => { if (!reduce) timer = window.setInterval(() => go(start + 1), 7000); };
    const halt = () => window.clearInterval(timer);
    root.addEventListener('mouseenter', halt); root.addEventListener('mouseleave', run);
    root.addEventListener('focusin', halt); root.addEventListener('focusout', run);
    let startX = 0;
    grid.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    grid.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) { halt(); go(start + (dx < 0 ? 1 : -1)); run(); }
    });
    addEventListener('resize', render);
    render(); run();
  });
</script>

<style>
  .testi { display: grid; gap: 2.5rem; }
  .head { display: grid; justify-items: center; text-align: center; gap: .9rem; }
  .head h2 { max-width: 22ch; }
  .note { color: var(--muted); font-size: .85rem; }

  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; align-items: stretch; }
  .grid.swap .tcard { animation: fade .6s ease both; }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .tcard { margin: 0; background: var(--white); border: 1px solid var(--line); padding: 2rem 1.75rem 1.5rem; display: grid; grid-template-rows: auto 1fr auto; gap: 1.1rem; }
  .tcard[hidden] { display: none; }
  .quote-ico { color: #b9d6ff; }
  blockquote { margin: 0; color: var(--text); font-size: 1.02rem; line-height: 1.7; }
  figcaption { display: flex; align-items: center; gap: .85rem; border-top: 1px solid var(--line); padding-top: 1.1rem; }
  .avatar { display: grid; place-items: center; width: 56px; height: 56px; object-fit: cover; color: #fff; font-weight: 800; font-size: .9rem; letter-spacing: .03em; flex: none; }
  .who { display: grid; min-width: 0; }
  .who strong { color: var(--navy); }
  .who small { color: var(--muted); }
  .wa { margin-left: auto; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #25d366; color: #fff; flex: none; box-shadow: 0 3px 10px rgb(37 211 102 / .35); }
  .wa:hover { background: #1ebe5a; }

  .controls { display: flex; align-items: center; justify-content: center; gap: 1rem; }
  .nav { width: 44px; height: 44px; border: 1px solid #c3d2de; background: var(--white); color: var(--navy); font-size: 1.1rem; }
  .nav:hover { border-color: var(--blue); color: var(--blue); }
  .count { margin: 0; min-width: 5rem; text-align: center; color: var(--muted); font-size: .9rem; letter-spacing: .12em; }
  .count b { color: var(--navy); }

  @media (max-width: 64rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .grid { grid-template-columns: 1fr; } }

  .tcard { border-radius: 18px; box-shadow: 0 8px 24px rgb(7 27 53 / .05); }
  .avatar { border-radius: 50%; }
  .nav { border-radius: 50%; }

  /* ===== Escala compacta: 5 tarjetas ===== */
  .testi { gap: 1.5rem; }
  .head h2 { max-width: 30ch; }
  .grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .9rem; }
  .tcard { padding: 1.1rem 1rem .9rem; gap: .7rem; border-radius: 14px; }
  .quote-ico { width: 24px; height: 24px; }
  blockquote { font-size: .86rem; line-height: 1.55; }
  figcaption { gap: .55rem; padding-top: .75rem; }
  .avatar { width: 38px; height: 38px; font-size: .75rem; }
  .who strong { font-size: .8rem; }
  .who small { font-size: .7rem; }
  .wa { width: 28px; height: 28px; }
  .wa svg { width: 14px; height: 14px; }
  .nav { width: 36px; height: 36px; }
  @media (max-width: 1200px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .grid { grid-template-columns: minmax(0, 1fr); } }

  /* ===== Más holgura en las tarjetas ===== */
  .testi { gap: 2rem; }
  .grid { gap: 1.25rem; }
  .tcard { padding: 1.5rem 1.4rem 1.2rem; gap: 1rem; }
  .quote-ico { width: 28px; height: 28px; }
  blockquote { font-size: .95rem; line-height: 1.65; }
  figcaption { gap: .7rem; padding-top: 1rem; }
  .avatar { width: 44px; height: 44px; font-size: .8rem; }
  .who strong { font-size: .88rem; }
  .who small { font-size: .76rem; }
  .wa { width: 32px; height: 32px; }
  .wa svg { width: 16px; height: 16px; }
  .grid { touch-action: pan-y; }
</style>
