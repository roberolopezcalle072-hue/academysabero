---
const path = Astro.url.pathname;
const items = [
  { href: '/admin', label: 'Panel', icon: 'M3 11.5 12 4l9 7.5M5.5 10v9.5h13V10' },
  { href: '/admin/pagos', label: 'Pagos', icon: 'M3.500 7h17v11h-17zM3.500 11h17M7 15h3' },
  { href: '/admin/consultas', label: 'Consultas', icon: 'M4 5.5h16v10.5H9.5L5 19.5V16H4z' },
  { href: '/admin/cronograma', label: 'Cronograma', icon: 'M4 6.5h16M4 6.5v13h16v-13M4 6.5v-1.5h16v1.5M8 3.5v3M16 3.5v3M8 11h3M13 11h3M8 15h3' },
  { href: '/admin/alumnos', label: 'Alumnos', icon: 'M9 11a3.500 3.500 0 1 0 0-7 3.500 3.500 0 0 0 0 7zM2.500 19.500c.5-3.500 3-5.500 6.500-5.500s6 2 6.500 5.500M16 5.500a3 3 0 0 1 0 5.500M18 14.500c2 .6 3.200 2.300 3.500 5' },
  { href: '/admin/solicitudes', label: 'Solicitudes', icon: 'M6 3.500h9l3 3v14H6zM14.500 3.500v4h4M9 12h6M9 15.500h6' },
  { href: '/admin/cursos', label: 'Programa y cursos', icon: 'M4 5.500c3-1.300 5.500-1.300 8 .5 2.500-1.800 5-1.800 8-.5v13c-3-1.300-5.500-1.300-8 .5-2.500-1.800-5-1.800-8-.5zM12 6v13' },
  { href: '/admin/sesiones', label: 'Sesiones en vivo', icon: 'M4 7.500h10v9H4zM14 11l6-3.500v9L14 13' },
  { href: '/admin/reclamos', label: 'Reclamaciones', icon: 'M5 4h11l3 3v13H5zM8 10h8M8 14h8' },
  { href: '/admin/accesos', label: 'Accesos manuales', icon: 'M12 3l7 3v5c0 4.500-3 8-7 10-4-2-7-5.500-7-10V6z' },
];
const on = (href: string) => (href === '/admin' ? path === '/admin' : path.startsWith(href));
---
<nav class="campus-nav" aria-label="Navegación de administración">
  <p class="nav-title">Administración</p>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={on(item.href) ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <a class="back" href="/campus">Ir al campus</a>
</nav>
<style>
  .campus-nav { padding: 1.75rem 1rem 1.5rem 1.25rem; }
  .nav-title { margin: 0 0 .9rem .75rem; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #6f87b8; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .2rem; }
  a { display: flex; align-items: center; gap: .75rem; padding: .62rem .75rem; border-radius: 10px; color: #aebfdd; text-decoration: none; font-size: .92rem; font-weight: 500; border: 1px solid transparent; transition: background .15s, color .15s; }
  a svg { flex: none; opacity: .85; }
  a:hover { background: rgb(255 255 255 / .05); color: #fff; }
  a[aria-current] { background: rgb(47 149 255 / .14); border-color: rgb(47 149 255 / .28); color: #fff; }
  a[aria-current] svg { color: #5cc8ff; opacity: 1; }
  .back { margin-top: 1.2rem; font-size: .85rem; color: #7f95bf; }
  @media (max-width: 62rem) {
    .campus-nav { padding: .6rem 1rem; border-bottom: 1px solid rgb(255 255 255 / .08); }
    .nav-title, .back { display: none; }
    ul { display: flex; gap: .35rem; overflow-x: auto; scrollbar-width: none; padding-bottom: .1rem; }
    ul::-webkit-scrollbar { display: none; }
    a { white-space: nowrap; padding: .5rem .8rem; font-size: .88rem; }
  }
</style>
