---
const path = Astro.url.pathname;
const student = Astro.locals.member?.role === 'student';
---
<nav class="shell campus-nav" aria-label="Navegación del campus">
  <a href="/campus" aria-current={path === '/campus' ? 'page' : undefined}>Resumen</a>
  <a href="/campus/cronograma" aria-current={path === '/campus/cronograma' ? 'page' : undefined}>Cronograma</a>
  <a href="/campus#cursos" aria-current={path.startsWith('/campus/cursos/') ? 'location' : undefined}>Mis cursos</a>
  {student && <a href="/campus/sesiones" aria-current={path === "/campus/sesiones" ? "page" : undefined}>Sesiones en vivo</a>}
  {student && <a href="/campus/consultas" aria-current={path === '/campus/consultas' ? 'page' : undefined}>Consultas</a>}
</nav>
<style>
  .campus-nav { display: flex; flex-wrap: wrap; gap: .25rem 1.4rem; border-bottom: 1px solid var(--line); }
  a { padding-block: .8rem; border-bottom: 2px solid transparent; color: var(--text); text-decoration: none; }
  a:hover, a[aria-current] { border-bottom-color: var(--blue); color: var(--link); }
  @media (max-width: 40rem) { .campus-nav { gap: 0 1.1rem; } a { padding-block: .7rem; font-size: .92rem; } }
</style>
