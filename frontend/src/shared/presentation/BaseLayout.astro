---
import '../styles/global.css';
import WhatsAppButton from '../../features/landing/WhatsAppButton.astro';
import { footerColumns, CONTACT_EMAIL, whatsappUrl } from '../../features/landing/content';

interface Props { title: string; privatePage?: boolean; description?: string; dark?: boolean }
const { title, privatePage = false, description: pageDescription, dark = false } = Astro.props;
const member = Astro.locals.member;
const site = 'https://academy.saberoconsulting.com';
const description = pageDescription ?? 'Campus privado de formación de SABERO Consulting.';
const fullTitle = `${title} | SABERO ACADEMY`;
const canonical = `${site}${Astro.url.pathname}`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'SABERO Consulting',
      url: site,
      logo: { '@type': 'ImageObject', url: `${site}/logos/logobuscador-512.png`, width: 512, height: 512 },
      image: `${site}/logos/logoapp.png`,
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'SABERO ACADEMY',
      alternateName: 'SABERO Academy',
      inLanguage: 'es',
      publisher: { '@id': `${site}/#organization` },
    },
  ],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <meta name="description" content={description} />
    <meta name="robots" content={privatePage ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logos/logobuscador-192.png" />
    <link rel="icon" type="image/webp" href="/logos/logobuscador.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SABERO ACADEMY" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/logos/logoapp-og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/logos/logoapp-og.png`} />
    {!privatePage && <script type="application/ld+json" set:html={jsonLd} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class={`site-header${dark ? ' dark' : ''}`}>
      <div class="shell header-content">
        {dark ? (
          <a class="brand" href="/" aria-label="SABERO ACADEMY">
            <svg class="cap" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#8ec5ff" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M2.5 9 12 4l9.5 5L12 14z" /><path d="M6.5 11.3V16c0 1.4 2.4 2.8 5.5 2.8s5.500-1.400 5.500-2.800v-4.700" /><path d="M21.500 9v6" /></svg>
            <span class="name"><b>SABERO</b><i>ACADEMY</i></span>
            <span class="sep" aria-hidden="true"></span>
            <span class="tag">Formación práctica en<br />Tecnología e Inteligencia Artificial</span>
          </a>
        ) : (
          <a class="wordmark" href="/" aria-label="SABERO ACADEMY"><img src="/logos/logoapp.webp" alt="SABERO ACADEMY" width="180" height="60" style="display:block;height:42px;width:auto" /></a>
        )}
        <nav aria-label="Navegación principal" class="main-nav">
          {privatePage ? (
            <>
              <div class="nav-links">
                <a class="nav-link" href="/cuenta" aria-current={Astro.url.pathname.startsWith('/cuenta') ? 'page' : undefined}>Mi cuenta</a>
                {member && <a class="nav-link" href="/campus" aria-current={Astro.url.pathname.startsWith('/campus') ? 'page' : undefined}>Campus</a>}
                {member?.role === 'admin' && <a class="nav-link" href="/admin" aria-current={Astro.url.pathname.startsWith('/admin') ? 'page' : undefined}>Administración</a>}
                <form method="post" action="/auth/salir"><button class="button outline">Cerrar sesión</button></form>
              </div>
              <details class="burger">
                <summary aria-label="Abrir menú"><span class="lines"></span></summary>
                <div class="drawer">
                  <a href="/cuenta">Mi cuenta</a>
                  {member && <a href="/campus">Campus</a>}
                  {member?.role === 'admin' && <a href="/admin">Administración</a>}
                  <form method="post" action="/auth/salir"><button class="button outline">Cerrar sesión</button></form>
                </div>
              </details>
            </>
          ) : (
            <>
              <div class="nav-links">
                <a class="nav-link" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Inicio</a>
                <a class="nav-link" href="/#nosotros">Nosotros</a>
                <a class="nav-link" href="/#servicios">Servicios</a>
                <a class="nav-link" href="/#vision">Visión</a>
                <a class="nav-link" href="/#comentarios">Comentarios</a>
              </div>
              <a class="button primary nav-cta" href="/ingresar">Iniciar sesión</a>
              <details class="burger">
                <summary aria-label="Abrir menú"><span class="lines"></span></summary>
                <div class="drawer">
                  <a href="/">Inicio</a>
                  <a href="/#nosotros">Nosotros</a>
                  <a href="/#servicios">Servicios</a>
                  <a href="/#vision">Visión</a>
                  <a href="/#comentarios">Comentarios</a>
                  <a href="/registro">Crear cuenta</a>
                </div>
              </details>
            </>
          )}
        </nav>
      </div>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      {!privatePage && (
        <div class="shell footer-columns">
          {footerColumns.map(col => (
            <nav aria-label={col.title}>
              <h2>{col.title}</h2>
              <ul>
                {col.links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
              </ul>
            </nav>
          ))}
        </div>
      )}
      <div class="footer-bar">
        <div class="shell footer-bottom">
          <div class="brand-line"><span class="brand-mark">SABERO <b>ACADEMY</b></span><span>© {new Date().getFullYear()} SABERO Consulting. Todos los derechos reservados.</span></div>
          <div class="contact-line">
            {CONTACT_EMAIL && <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>}
            {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>}
            <span class="lang">Español</span>
          </div>
        </div>
      </div>
    </footer>
    <script is:inline data-id="burger-script">
      document.querySelectorAll('.burger').forEach(function (d) {
        d.addEventListener('click', function (e) { if (e.target.closest('.drawer a')) d.removeAttribute('open'); });
        document.addEventListener('click', function (e) { if (!d.contains(e.target)) d.removeAttribute('open'); });
      });
    </script>
    {!privatePage && !['/registro', '/ingresar'].includes(Astro.url.pathname) && <WhatsAppButton />}
  </body>
</html>
