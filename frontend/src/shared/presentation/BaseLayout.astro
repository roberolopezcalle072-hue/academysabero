---
import '../styles/global.css';
import WhatsAppButton from '../../features/landing/WhatsAppButton.astro';

interface Props { title: string; privatePage?: boolean; description?: string }
const { title, privatePage = false, description: pageDescription } = Astro.props;
const member = Astro.locals.member;
const site = 'https://academy.saberoconsulting.com';
const description = pageDescription ?? 'Campus privado de formación de SABERO Consulting.';
const fullTitle = `${title} | SABERO ACADEMY`;
const canonical = `${site}${Astro.url.pathname}`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'SABERO Consulting',
      url: site,
      logo: { '@type': 'ImageObject', url: `${site}/logos/logobuscador-512.png`, width: 512, height: 512 },
      image: `${site}/logos/logoapp.png`,
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: site,
      name: 'SABERO ACADEMY',
      alternateName: 'SABERO Academy',
      inLanguage: 'es',
      publisher: { '@id': `${site}/#organization` },
    },
  ],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <meta name="description" content={description} />
    <meta name="robots" content={privatePage ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logos/logobuscador-192.png" />
    <link rel="icon" type="image/webp" href="/logos/logobuscador.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SABERO ACADEMY" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/logos/logoapp-og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/logos/logoapp-og.png`} />
    {!privatePage && <script type="application/ld+json" set:html={jsonLd} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="site-header">
      <div class="shell header-content">
        <a class="wordmark" href="/" aria-label="SABERO ACADEMY"><img src="/logos/logoapp.webp" alt="SABERO ACADEMY" width="180" height="60" style="display:block;height:52px;width:auto" /></a>
        <nav aria-label="Navegación principal">
          {privatePage ? (
            <>
              <a class="nav-link" href="/campus" aria-current={Astro.url.pathname.startsWith('/campus') ? 'page' : undefined}>Campus</a>
              {member?.role === 'admin' && <a class="nav-link" href="/admin" aria-current={Astro.url.pathname.startsWith('/admin') ? 'page' : undefined}>Administración</a>}
              <form method="post" action="/auth/salir"><button class="button outline">Cerrar sesión</button></form>
            </>
          ) : (
            <>
              <a class="nav-link" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Inicio</a>
              <a class="nav-link" href="/#nosotros">Nosotros</a>
              <a class="nav-link" href="/#servicios">Servicios</a>
              <a class="nav-link" href="/#vision">Visión</a>
              <a class="nav-link" href="/#comentarios">Comentarios</a>
              <a class="button primary nav-cta" href="/ingresar">Iniciar sesión</a>
            </>
          )}
        </nav>
      </div>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-content"><strong>SABERO Consulting</strong><span>Academia privada de formación</span><nav aria-label="Legal" class="legal"><a href="/privacidad">Privacidad</a><a href="/terminos">Términos</a></nav></div>
    </footer>
    {!privatePage && <WhatsAppButton />}
  </body>
</html>
