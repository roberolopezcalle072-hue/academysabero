HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=https://academy.saberoconsulting.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Pagos con pasarela (opcional: sin PAYMENT_PROVIDER el pago en línea queda desactivado) ---
# Pasarela activa: culqi (producción) | mock (solo desarrollo). Para cambiar de pasarela: ver backend/src/modules/payments.
PAYMENT_PROVIDER=
CULQI_PUBLIC_KEY=pk_test_replace_me
CULQI_SECRET_KEY=sk_test_replace_me
# Secreto interno que confirma pagos en la base (su resumen SHA-256 vive en academy_internal_secrets).
PAYMENT_INTERNAL_SECRET=replace_me
